        function hideAllScreens() {
            ['screenTitle', 'screenMenu', 'screenOnline', 'screenGacha', 'screenMyTeam', 'screenMatch'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.add('hidden');
            });
            const resModal = document.getElementById('matchResultModal');
            if (resModal) resModal.classList.add('hidden');
        }

        function goToMenu() {
            isMatchRunning = false;
            isMatchFinished = false;
            isOnlineMatch = false;
            isGkHoldingBall = false;
            isFreeKickHolding = false;
            onlineRole = null;
            if (roomUnsubscribe) {
                roomUnsubscribe();
                roomUnsubscribe = null;
            }
            if (roomsListUnsubscribe) {
                roomsListUnsubscribe();
                roomsListUnsubscribe = null;
            }
            if (matchTimerInterval) {
                clearInterval(matchTimerInterval);
                matchTimerInterval = null;
            }
            if (animationFrameId) {
                cancelAnimationFrame(animationFrameId);
                animationFrameId = null;
            }
            hideAllScreens();
            const menu = document.getElementById('screenMenu');
            if (menu) menu.classList.remove('hidden');
            updateCurrencyDisplays();
        }

        function forceStartDevice() {
            const warn = document.getElementById('deviceWarning');
            if (warn) warn.classList.add('hidden');
            goToMenu();
        }

        function dismissOrientationWarning() {
            document.body.classList.add('allow-portrait');
            const warn = document.getElementById('orientationWarning');
            if (warn) warn.classList.add('hidden');
            onWindowResize();
        }

        function updateCurrencyDisplays() {
            const coinText = userCoins.toLocaleString() + ' Coins';
            const gpText = userGP.toLocaleString() + ' GP';
            const menuCoin = document.getElementById('menuCoinCount');
            const menuGp = document.getElementById('menuGPCount');
            const gachaCoin = document.getElementById('gachaCoinCount');
            const gachaGp = document.getElementById('gachaGPCount');
            if (menuCoin) menuCoin.innerText = coinText;
            if (menuGp) menuGp.innerText = gpText;
            if (gachaCoin) gachaCoin.innerText = coinText;
            if (gachaGp) gachaGp.innerText = gpText;
        }

        function updateMatchTimerDisplay() {
            const mins = String(Math.floor(matchTimeSeconds / 60)).padStart(2, '0');
            const secs = String(matchTimeSeconds % 60).padStart(2, '0');
            const timerEl = document.getElementById('matchTimer');
            const halfEl = document.getElementById('matchHalfLabel');
            if (timerEl) timerEl.innerText = `${mins}:${secs}`;
            if (halfEl) halfEl.innerText = matchTimeSeconds >= 150 ? '2ND HALF' : '1ST HALF';
        }

        function finishMatch() {
            if (isMatchFinished) return;
            isMatchFinished = true;
            isMatchRunning = false;
            if (matchTimerInterval) {
                clearInterval(matchTimerInterval);
                matchTimerInterval = null;
            }

            const isGuestClient = isOnlineMatch && onlineRole === 'guest';
            const myScore = isGuestClient ? scoreBlue : scoreRed;
            const oppScore = isGuestClient ? scoreRed : scoreBlue;

            const titleEl = document.getElementById('matchResultTitle');
            const badgeEl = document.getElementById('matchRewardBadge');
            const fRed = document.getElementById('finalScoreRed');
            const fBlue = document.getElementById('finalScoreBlue');
            const rematchBtn = document.getElementById('rematchBtn');

            if (fRed) fRed.innerText = String(scoreRed);
            if (fBlue) fBlue.innerText = String(scoreBlue);
            if (rematchBtn) {
                if (isOnlineMatch) rematchBtn.classList.add('hidden');
                else rematchBtn.classList.remove('hidden');
            }

            if (myScore > oppScore) {
                userCoins += 100;
                userGP += 3000;
                if (titleEl) {
                    titleEl.innerText = 'VICTORY!';
                    titleEl.className = 'ef-font text-6xl font-black text-ef-yellow tracking-wider leading-none mb-3';
                }
                if (badgeEl) {
                    badgeEl.innerText = currentLang === 'en' ? 'WIN REWARD: +100 Coins / +3,000 GP' : '勝利報酬: +100 Coins / +3,000 GP';
                    badgeEl.className = 'bg-amber-500/20 border border-amber-400 text-amber-300 font-black text-sm py-2.5 px-4 rounded-xl mb-6';
                }
            } else if (myScore === oppScore) {
                userCoins += 20;
                userGP += 1000;
                if (titleEl) {
                    titleEl.innerText = 'DRAW';
                    titleEl.className = 'ef-font text-6xl font-black text-cyan-300 tracking-wider leading-none mb-3';
                }
                if (badgeEl) {
                    badgeEl.innerText = currentLang === 'en' ? 'DRAW REWARD: +20 Coins / +1,000 GP' : '引き分け報酬: +20 Coins / +1,000 GP';
                    badgeEl.className = 'bg-cyan-500/20 border border-cyan-400 text-cyan-200 font-black text-sm py-2.5 px-4 rounded-xl mb-6';
                }
            } else {
                userGP += 500;
                if (titleEl) {
                    titleEl.innerText = 'DEFEAT';
                    titleEl.className = 'ef-font text-6xl font-black text-rose-400 tracking-wider leading-none mb-3';
                }
                if (badgeEl) {
                    badgeEl.innerText = currentLang === 'en' ? 'MATCH REWARD: +500 GP' : '参加報酬: +500 GP';
                    badgeEl.className = 'bg-slate-800 border border-gray-600 text-gray-300 font-black text-sm py-2.5 px-4 rounded-xl mb-6';
                }
            }

            updateCurrencyDisplays();
            if (window.saveCloudData) window.saveCloudData(true);

            const modal = document.getElementById('matchResultModal');
            if (modal) modal.classList.remove('hidden');
        }

        function closeMatchResultAndMenu() {
            const modal = document.getElementById('matchResultModal');
            if (modal) modal.classList.add('hidden');
            goToMenu();
