<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>eFootball 2026 iPad Edition</title>
    <!-- Tailwind CSS & FontAwesome -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Three.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Firebase SDK (Online PvP Realtime Sync) -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, getDoc, setDoc, updateDoc, deleteDoc, onSnapshot, collection } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        window.FirebasePvP = {
            ready: false,
            db: null,
            auth: null,
            user: null,
            appId: typeof __app_id !== 'undefined' ? __app_id : 'efootball-2026-pvp',
            fns: { doc, getDoc, setDoc, updateDoc, deleteDoc, onSnapshot, collection }
        };

        async function initFirebasePvP() {
            try {
                if (typeof __firebase_config === 'undefined' || !__firebase_config) {
                    if (window.onPvPAuthStateReady) window.onPvPAuthStateReady(false, 'Standalone File Mode');
                    return;
                }
                const firebaseConfig = JSON.parse(__firebase_config);
                const app = initializeApp(firebaseConfig);
                const auth = getAuth(app);
                const db = getFirestore(app);

                let cred;
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    cred = await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    cred = await signInAnonymously(auth);
                }

                window.FirebasePvP.db = db;
                window.FirebasePvP.auth = auth;
                window.FirebasePvP.user = cred.user;
                window.FirebasePvP.ready = true;

                if (window.loadCloudSaveData) await window.loadCloudSaveData();
                if (window.onPvPAuthStateReady) window.onPvPAuthStateReady(true, cred.user.uid);
            } catch (err) {
                if (window.onPvPAuthStateReady) window.onPvPAuthStateReady(false, err.message || '接続エラー');
            }
        }

        initFirebasePvP();
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Teko:wght@600;700&family=Noto+Sans+JP:wght@500;700;900&display=swap');

        body {
            font-family: 'Noto Sans JP', sans-serif;
            background-color: #030712;
            color: #ffffff;
            overflow: hidden;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
            touch-action: none;
        }

        .ef-font { font-family: 'Teko', sans-serif; }

        /* eFootball Theme Colors & Gradients */
        .bg-ef-gradient {
            background: radial-gradient(circle at center, #0f172a 0%, #020617 100%);
        }
        .text-ef-cyan { color: #00f0ff; text-shadow: 0 0 10px rgba(0, 240, 255, 0.6); }
        .text-ef-yellow { color: #ccff00; text-shadow: 0 0 10px rgba(204, 255, 0, 0.6); }
        .bg-ef-cyan { background-color: #00f0ff; }
        .bg-ef-yellow { background-color: #ccff00; }

        .ef-card {
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(30, 41, 59, 0.8) 100%);
            border: 1px solid rgba(0, 240, 255, 0.3);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(8px);
        }

        .ef-btn {
            background: linear-gradient(90deg, #00f0ff 0%, #0077ff 100%);
            transition: all 0.2s ease;
        }
        .ef-btn:active {
            transform: scale(0.96);
            opacity: 0.9;
        }

        /* 3D Canvas Fill Screen */
        /* Virtual Joystick Touch UI (Floating Dynamic Base) */
        .joystick-base {
            width: 164px;
            height: 164px;
            background: rgba(255, 255, 255, 0.14);
            border: 3px solid rgba(0, 240, 255, 0.45);
            border-radius: 50%;
            position: absolute;
            left: 24px;
            bottom: 24px;
            touch-action: none;
            transition: border-color 0.12s ease, background-color 0.12s ease, box-shadow 0.12s ease;
        }
        .joystick-base.joystick-active {
            background: rgba(0, 240, 255, 0.16);
            border-color: rgba(0, 240, 255, 0.9);
            box-shadow: 0 0 24px rgba(0, 240, 255, 0.35);
        }

        .joystick-stick {
            width: 68px;
            height: 68px;
            background: radial-gradient(circle, #00f0ff 0%, #0077ff 100%);
            border-radius: 50%;
            position: absolute;
            top: 48px;
            left: 48px;
            box-shadow: 0 0 18px #00f0ff;
        }

        /* Action Buttons Grid */
        .action-btn {
            width: 88px;
            height: 88px;
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 15px;
            letter-spacing: 0.03em;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.55);
            border: 2.5px solid rgba(255, 255, 255, 0.25);
            position: relative;
            transition: transform 0.08s ease, box-shadow 0.08s ease, filter 0.08s ease, border-color 0.08s ease;
        }
        .action-btn:active,
        .action-btn.btn-pressed {
            transform: scale(0.86);
            filter: brightness(1.4);
            border: 4px solid #ffffff !important;
            box-shadow: 0 0 28px rgba(255, 255, 255, 0.95), inset 0 0 18px rgba(255, 255, 255, 0.65) !important;
        }
        .action-btn.btn-pressed::after {
            content: '';
            position: absolute;
            inset: -8px;
            border-radius: 50%;
            border: 3px solid rgba(255, 255, 255, 0.85);
            animation: btn-ring-pulse 0.75s infinite ease-out;
            pointer-events: none;
        }
        @keyframes btn-ring-pulse {
            0% { transform: scale(0.95); opacity: 1; }
            100% { transform: scale(1.22); opacity: 0; }
        }

        /* Shimmer Animation for Card Pack */
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }
        .animate-shimmer {
            background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.3) 50%, rgba(255,255,255,0) 100%);
            background-size: 200% 100%;
            animation: shimmer 2.5s infinite;
        }

        /* eFootball Pitch Formation Board Style */
        .pitch-board {
            background: radial-gradient(circle, #15803d 0%, #14532d 100%);
            border: 2px solid rgba(0, 240, 255, 0.4);
            box-shadow: inset 0 0 40px rgba(0,0,0,0.8), 0 0 20px rgba(0,240,255,0.2);
            position: relative;
        }
        .pitch-line {
            border: 2px solid rgba(255,255,255,0.35);
            position: absolute;
        }

        /* Selection effect for player swap */
        .player-selected {
            animation: pulse-border 1.2s infinite;
            border-color: #ccff00 !important;
            box-shadow: 0 0 20px #ccff00 !important;
        }
        @keyframes pulse-border {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.15); }
        }

        /* Power Gauge Styling */
        .power-bar-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #22c55e 0%, #eab308 60%, #ef4444 100%);
            transition: width 0.05s linear;
        }

        /* Landscape Orientation Guard */
        @media screen and (orientation: portrait) {
            body:not(.allow-portrait) #orientationWarning {
                display: flex !important;
            }
        }
    </style>
</head>
<body class="w-screen h-screen overflow-hidden bg-ef-gradient select-none">

    <!-- Landscape Lock Orientation Overlay -->
    <div id="orientationWarning" class="fixed inset-0 z-50 bg-black/95 flex flex-col items-center justify-center p-6 text-center hidden">
        <i class="fa-solid fa-rotate text-6xl text-ef-yellow mb-4 animate-spin"></i>
        <h2 class="text-3xl font-black text-white mb-2 ef-font">ROTATE YOUR DEVICE</h2>
        <p id="orientationWarningDesc" class="text-cyan-400 text-sm font-bold max-w-sm mb-6">横画面（Landscape）でのプレイを推奨します。端末を横向きにするか、下のボタンからそのまま開始できます。</p>
        <button id="allowPortraitBtn" onclick="dismissOrientationWarning()" class="px-6 py-3 bg-ef-cyan text-black font-black text-xs rounded-full shadow-lg active:scale-95 transition-all">
            このままプレイ (PLAY ANYWAY)
        </button>
    </div>

    <!-- iPad Lock Warning Modal -->
    <div id="deviceWarning" class="fixed inset-0 z-50 bg-black/95 flex flex-col items-center justify-center p-6 text-center hidden">
        <i class="fa-solid font-bold fa-tablet-screen-button text-6xl text-ef-cyan mb-4 animate-bounce"></i>
        <h2 class="text-2xl font-bold text-white mb-2">iPad / Touch Device Dedicated</h2>
        <p id="deviceWarningDesc" class="text-gray-400 text-sm max-w-sm mb-6">このアプリはiPadおよびタッチ操作端末専用に設計されています。</p>
        <button id="deviceWarningBtn" onclick="forceStartDevice()" class="px-6 py-3 bg-ef-cyan text-black font-extrabold rounded-full">プレイを試みる</button>
    </div>

    <!-- 1. Start / Title Screen -->
    <div id="screenTitle" onclick="goToMenu()" class="fixed inset-0 z-40 bg-ef-gradient flex flex-col items-center justify-between p-8 cursor-pointer">
        <div class="w-full flex justify-end">
            <button onclick="event.stopPropagation(); toggleLanguage();" class="px-4 py-2 rounded-full bg-slate-900/90 border border-cyan-400/60 text-xs font-black text-cyan-300 hover:bg-cyan-400 hover:text-black transition-all flex items-center space-x-1.5 shadow-lg">
                <i class="fa-solid fa-language text-sm"></i>
                <span class="lang-toggle-label">日本語 / EN</span>
            </button>
        </div>
        <div class="mt-4 text-center pointer-events-none">
            <h1 class="ef-font text-7xl font-extrabold tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-yellow-300 to-blue-500 italic">
                eFootball 2026
            </h1>
            <p class="text-sm tracking-widest text-gray-300 font-bold uppercase mt-1">iPad Ultra Touch Edition</p>
        </div>

        <div class="text-center mb-16 animate-pulse pointer-events-none">
            <div class="text-ef-cyan text-2xl font-extrabold tracking-widest mb-2">TOUCH TO START</div>
            <div id="titleSubPrompt" class="text-xs text-gray-400">画面をタップしてピッチへ進む</div>
        </div>

        <div class="flex justify-between w-full text-xs text-gray-500 border-t border-gray-800 pt-4 pointer-events-none">
            <span>© KONAMI Fan Edition</span>
            <span>v4.6.0-Standalone Ready</span>
        </div>
    </div>

    <!-- 2. Main Menu Screen -->
    <div id="screenMenu" class="fixed inset-0 z-30 bg-ef-gradient p-8 flex flex-col justify-between hidden">
        <div class="flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-full bg-cyan-400 flex items-center justify-center text-black font-black">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div>
                    <div class="text-sm font-bold text-white">USER TEAM</div>
                    <div class="text-xs text-cyan-400 font-bold">DIVISION 1</div>
                </div>
            </div>
            <div class="flex items-center space-x-2.5 text-sm font-bold">
                <button onclick="toggleLanguage()" class="bg-slate-900/90 hover:bg-cyan-400 hover:text-black px-3 py-2 rounded-xl border border-cyan-400/50 text-cyan-300 text-xs font-black transition-all flex items-center space-x-1">
                    <i class="fa-solid fa-language"></i><span class="lang-toggle-label">JP / EN</span>
                </button>
                <div id="saveStatusBadge" class="bg-slate-900/90 px-3 py-2 rounded-xl border border-emerald-400/40 text-emerald-300 text-xs flex items-center space-x-1.5">
                    <i class="fa-solid fa-cloud"></i><span id="saveStatusText">同期待機中...</span>
                </div>
                <button onclick="saveCloudData(false)" class="bg-emerald-500 hover:bg-emerald-400 text-black px-3.5 py-2 rounded-xl font-black text-xs shadow-lg active:scale-95 transition-all flex items-center space-x-1">
                    <i class="fa-solid fa-floppy-disk"></i><span>SAVE</span>
                </button>
                <button onclick="openResetSaveModal()" class="bg-slate-800 hover:bg-red-900/80 text-gray-300 hover:text-white px-3 py-2 rounded-xl border border-gray-600 text-xs font-bold transition-all" title="セーブデータ初期化">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
                <div class="bg-slate-900/90 px-4 py-2 rounded-xl border border-yellow-400/40 text-yellow-400">
                    <i class="fa-solid fa-coins mr-1.5"></i><span id="menuCoinCount">2,500 Coins</span>
                </div>
                <div class="bg-slate-900/90 px-4 py-2 rounded-xl border border-cyan-400/40 text-cyan-400">
                    <i class="fa-solid fa-wallet mr-1.5"></i><span id="menuGPCount">150,000 GP</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-4 gap-5 my-auto max-w-6xl mx-auto w-full">
            <div onclick="startMatchSetup()" class="ef-card p-5 rounded-3xl border-2 border-cyan-400 cursor-pointer transform hover:scale-105 transition-all flex flex-col justify-between h-64 bg-gradient-to-br from-cyan-950/60 to-slate-900">
                <div class="flex justify-between items-start">
                    <span class="text-xs font-black text-cyan-400 bg-cyan-950 px-3 py-1 rounded-full border border-cyan-500/40">SOLO</span>
                    <i class="fa-solid fa-futbol text-3xl text-cyan-400"></i>
                </div>
                <div>
                    <h3 class="ef-font text-4xl font-extrabold text-white mb-1">TRIAL MATCH</h3>
                    <p id="menuCardSoloDesc" class="text-xs text-gray-300">3D TV中継カメラ試合 (vs CPU)</p>
                </div>
                <button class="w-full py-2.5 bg-cyan-400 text-black font-black text-sm rounded-xl">PLAY MATCH</button>
            </div>

            <div onclick="openMyTeamScreen()" class="ef-card p-5 rounded-3xl border-2 border-yellow-400 cursor-pointer transform hover:scale-105 transition-all flex flex-col justify-between h-64 bg-gradient-to-br from-yellow-950/60 to-slate-900">
                <div class="flex justify-between items-start">
                    <span class="text-xs font-black text-yellow-400 bg-yellow-950 px-3 py-1 rounded-full border border-yellow-500/40">MY TEAM</span>
                    <i class="fa-solid fa-users text-3xl text-yellow-400"></i>
                </div>
                <div>
                    <h3 class="ef-font text-4xl font-extrabold text-white mb-1">GAME PLAN</h3>
                    <p id="menuCardSquadDesc" class="text-xs text-gray-300">フォーメーション＆選手交代</p>
                </div>
                <button class="w-full py-2.5 bg-yellow-400 text-black font-black text-sm rounded-xl">EDIT SQUAD</button>
            </div>

            <div onclick="openGachaScreen()" class="ef-card p-5 rounded-3xl border-2 border-purple-400 cursor-pointer transform hover:scale-105 transition-all flex flex-col justify-between h-64 bg-gradient-to-br from-purple-950/60 to-slate-900">
                <div class="flex justify-between items-start">
                    <span class="text-xs font-black text-purple-400 bg-purple-950 px-3 py-1 rounded-full border border-purple-500/40">CONTRACT</span>
                    <i class="fa-solid fa-gem text-3xl text-purple-400"></i>
                </div>
                <div>
                    <h3 class="ef-font text-4xl font-extrabold text-white mb-1">SPECIAL PACKS</h3>
                    <p id="menuCardGachaDesc" class="text-xs text-gray-300">エピック＆ハイライト選手獲得</p>
                </div>
                <button class="w-full py-2.5 bg-purple-500 text-white font-black text-sm rounded-xl">GET PLAYERS</button>
            </div>

            <div onclick="openOnlineScreen()" class="ef-card p-5 rounded-3xl border-2 border-emerald-400 cursor-pointer transform hover:scale-105 transition-all flex flex-col justify-between h-64 bg-gradient-to-br from-emerald-950/60 to-slate-900">
                <div class="flex justify-between items-start">
                    <span class="text-xs font-black text-emerald-400 bg-emerald-950 px-3 py-1 rounded-full border border-emerald-500/40">2P REALTIME</span>
                    <i class="fa-solid fa-globe text-3xl text-emerald-400"></i>
                </div>
                <div>
                    <h3 class="ef-font text-4xl font-extrabold text-white mb-1">ONLINE PVP</h3>
                    <p id="menuCardOnlineDesc" class="text-xs text-gray-300">ルーム作成 / コード参加でリアルタイム対戦</p>
                </div>
                <button class="w-full py-2.5 bg-emerald-400 text-black font-black text-sm rounded-xl">ONLINE LOBBY</button>
            </div>
        </div>

        <div id="menuFooterNote" class="text-center text-xs text-gray-500">
            eFootball 2026 iPad Edition - All features active (Auto-Save Enabled)
        </div>
    </div>

    <!-- Custom Confirm Modal for Save Data Reset -->
    <div id="resetConfirmModal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md flex items-center justify-center p-6 hidden">
        <div class="ef-card max-w-md w-full p-6 rounded-3xl border-2 border-red-500/70 text-center">
            <i class="fa-solid fa-triangle-exclamation text-4xl text-red-400 mb-3"></i>
            <h3 class="ef-font text-3xl font-black text-white tracking-wide mb-2">RESET SAVE DATA?</h3>
            <p id="resetModalDesc" class="text-xs text-gray-300 mb-6 leading-relaxed">
                所持コイン・GP・獲得済み選手・フォーメーション・ガチャBOXの進行状況をすべて初期状態に戻します。この操作は取り消せません。
            </p>
            <div class="flex space-x-3">
                <button id="resetCancelBtn" onclick="closeResetSaveModal()" class="flex-1 py-2.5 bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs rounded-xl border border-gray-600">
                    キャンセル
                </button>
                <button id="resetConfirmBtn" onclick="executeResetSaveData()" class="flex-1 py-2.5 bg-red-600 hover:bg-red-500 text-white font-black text-xs rounded-xl shadow-lg">
                    初期化する
                </button>
            </div>
        </div>
    </div>

    <!-- 3. Online PvP Lobby Screen -->
    <div id="screenOnline" class="fixed inset-0 z-30 bg-ef-gradient p-6 flex flex-col justify-between hidden overflow-y-auto">
        <div class="flex justify-between items-center">
            <button onclick="leaveOnlineRoomAndGoMenu()" class="px-5 py-2 bg-slate-800 rounded-full text-sm font-bold flex items-center space-x-2 border border-gray-700 hover:border-emerald-400">
                <i class="fa-solid fa-arrow-left text-emerald-400"></i><span>MENU</span>
            </button>
            <h2 class="ef-font text-4xl font-extrabold text-white tracking-wider">ONLINE PVP LOBBY</h2>
            <div class="text-right text-xs">
                <div id="onlineAuthStatus" class="text-emerald-400 font-bold">接続準備中...</div>
                <div class="text-gray-400 font-mono text-[10px]">ID: <span id="onlineUserIdDisplay">---</span></div>
            </div>
        </div>

        <div id="onlineFeedbackBanner" class="max-w-3xl mx-auto w-full px-4 py-2 rounded-xl bg-emerald-500/20 border border-emerald-400 text-emerald-200 text-xs font-bold text-center hidden"></div>

        <div class="grid grid-cols-2 gap-6 max-w-4xl mx-auto w-full my-auto">
            <!-- Host Room Panel -->
            <div class="ef-card p-6 rounded-3xl border-2 border-emerald-400/60 flex flex-col justify-between">
                <div>
                    <span class="text-xs font-black text-emerald-400 bg-emerald-950 px-3 py-1 rounded-full border border-emerald-500/40">HOST</span>
                    <h3 class="ef-font text-3xl font-black text-white mt-2">CREATE ROOM</h3>
                    <p id="onlineHostSubDesc" class="text-xs text-gray-300 mt-1">4桁のルームコードを発行して対戦相手を待ちます。</p>
                </div>

                <div class="my-4 bg-slate-950/90 border border-emerald-500/40 rounded-2xl p-4 text-center">
                    <div class="text-[10px] text-gray-400 font-bold uppercase">ROOM CODE</div>
                    <div id="createdRoomCodeText" class="ef-font text-5xl font-black text-ef-yellow tracking-widest my-1">----</div>
                    <div id="hostWaitStatusText" class="text-xs text-cyan-300 font-bold">「ルーム作成」を押してください</div>
                </div>

                <div class="flex space-x-2">
                    <button id="createRoomBtn" onclick="createOnlineRoom()" class="flex-1 py-3 bg-emerald-400 hover:bg-emerald-300 text-black font-black text-xs rounded-xl shadow-lg">
                        ルーム作成 (HOST)
                    </button>
                    <button id="copyRoomCodeBtn" onclick="copyRoomCodeToClipboard()" class="px-4 py-3 bg-cyan-400 text-black font-black text-xs rounded-xl hidden">
                        <i class="fa-solid fa-copy"></i>
                    </button>
                    <button id="cancelRoomBtn" onclick="cancelHostedRoom()" class="px-4 py-3 bg-red-600 text-white font-black text-xs rounded-xl hidden">
                        取消
                    </button>
                </div>
            </div>

            <!-- Join Room Panel -->
            <div class="ef-card p-6 rounded-3xl border-2 border-cyan-400/60 flex flex-col justify-between">
                <div>
                    <span class="text-xs font-black text-cyan-400 bg-cyan-950 px-3 py-1 rounded-full border border-cyan-500/40">GUEST</span>
                    <h3 class="ef-font text-3xl font-black text-white mt-2">JOIN ROOM</h3>
                    <div class="flex space-x-2 mt-3">
                        <input id="joinRoomCodeInput" type="text" maxlength="4" placeholder="4桁コード" class="flex-1 bg-slate-950 border border-cyan-400/50 rounded-xl px-4 py-2 text-center font-mono font-black text-lg text-white focus:outline-none">
                        <button id="joinRoomSubmitBtn" onclick="joinOnlineRoomByInput()" class="px-5 py-2 bg-cyan-400 hover:bg-cyan-300 text-black font-black text-xs rounded-xl">
                            参加
                        </button>
                    </div>
                </div>

                <div class="mt-4">
                    <div class="flex justify-between items-center text-xs font-bold text-gray-300 mb-2">
                        <span id="openRoomsHeaderLabel">OPEN ROOMS (募集中)</span>
                        <span id="openRoomsCount" class="text-cyan-400">0 rooms</span>
                    </div>
                    <div id="openRoomsList" class="space-y-2 max-h-36 overflow-y-auto">
                        <div class="text-xs text-gray-400 bg-slate-950/60 p-3 rounded-xl text-center">現在待機中のルームはありません</div>
                    </div>
                </div>
            </div>
        </div>

        <div id="onlineFooterNote" class="text-center text-xs text-gray-500">
            両プレイヤーとも左から右へ攻めるTV中継カメラ視点で同期プレイが可能です
        </div>
