        function startMatchSetup() {
            if (typeof THREE === 'undefined') {
                const msg = currentLang === 'en'
                    ? '3D engine (Three.js) could not load in this file previewer. Please open this HTML file in Safari or Chrome.'
                    : 'このファイルプレビュー画面では3D描画エンジンが制限されています。SafariやChromeなどのブラウザでこのHTMLファイルを開いてプレイしてください。';
                const note = document.getElementById('menuFooterNote');
                if (note) {
                    note.innerText = msg;
                    note.className = 'text-center text-xs font-black text-red-400';
                }
                return;
            }

            isOnlineMatch = false;
            onlineRole = null;
            isMatchFinished = false;
            hideAllScreens();
            document.getElementById('screenMatch').classList.remove('hidden');

            scoreRed = 0;
            scoreBlue = 0;
            matchTimeSeconds = 0;
            document.getElementById('scoreRed').innerText = '0';
            document.getElementById('scoreBlue').innerText = '0';
            updateMatchTimerDisplay();

            if (!scene) {
                init3DScene();
            } else {
                createTeamPlayers();
            }
            onWindowResize();
            alignKickoffFormation();
            isMatchRunning = true;

            if (matchTimerInterval) clearInterval(matchTimerInterval);
            matchTimerInterval = setInterval(() => {
                if (!isMatchRunning || isKickoff || isKickoffWait || isGoalPause || isOffsideFlagged || isMatchFinished) return;
                matchTimeSeconds++;
                updateMatchTimerDisplay();
                if (matchTimeSeconds >= MATCH_DURATION_SECONDS) {
                    finishMatch();
                }
            }, 1000);

            if (animationFrameId) cancelAnimationFrame(animationFrameId);
            animateMatch();
        }

