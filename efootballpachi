        function setGachaViewMode(mode) {
            const packsBtn = document.getElementById('modeBtnPacks');
            const shopBtn = document.getElementById('modeBtnShop');
            const packTabs = document.getElementById('gachaPackTabs');
            const boxCard = document.getElementById('gachaBoxCard');
            const shopCard = document.getElementById('gpShopCard');

            if (mode === 'shop') {
                if (packsBtn) packsBtn.className = 'px-4 py-1.5 rounded-full text-xs font-black text-purple-300 hover:text-white transition-all';
                if (shopBtn) shopBtn.className = 'px-4 py-1.5 rounded-full text-xs font-black bg-cyan-400 text-black transition-all';
                if (packTabs) packTabs.classList.add('hidden');
                if (boxCard) boxCard.classList.add('hidden');
                if (shopCard) shopCard.classList.remove('hidden');
