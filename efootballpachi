        function subscribeOpenOnlineRooms() {
            const pvp = window.FirebasePvP;
            if (!pvp || !pvp.ready || !pvp.db) return;
            if (roomsListUnsubscribe) roomsListUnsubscribe();

            const { collection, onSnapshot } = pvp.fns;
            const roomsCol = collection(pvp.db, 'artifacts', pvp.appId, 'public', 'data', 'pvp_rooms');

            roomsListUnsubscribe = onSnapshot(roomsCol, (snapshot) => {
                const listEl = document.getElementById('openRoomsList');
                const countEl = document.getElementById('openRoomsCount');
                if (!listEl) return;

                const openRooms = [];
                snapshot.forEach(docSnap => {
                    const data = docSnap.data();
                    if (data && data.status === 'waiting' && docSnap.id !== currentOnlineRoomId) {
                        openRooms.push({ id: docSnap.id, ...data });
                    }
                });

                if (countEl) countEl.innerText = `${openRooms.length} room${openRooms.length === 1 ? '' : 's'}`;
                if (openRooms.length === 0) {
                    listEl.innerHTML = `<div class="text-xs text-gray-400 bg-slate-950/60 p-3 rounded-xl text-center">${currentLang === 'en' ? 'No open rooms available right now' : '現在待機中のルームはありません'}</div>`;
                    return;
                }

                listEl.innerHTML = '';
                openRooms.forEach(r => {
                    const row = document.createElement('div');
                    row.className = 'flex items-center justify-between bg-slate-950/90 border border-cyan-500/40 px-3 py-2 rounded-xl';
                    row.innerHTML = `
                        <div>
                            <span class="font-mono font-black text-ef-yellow text-sm">ROOM #${r.id}</span>
                            <span class="text-[10px] text-gray-400 ml-2">${currentLang === 'en' ? 'WAITING' : 'HOST待機中'}</span>
                        </div>
                        <button onclick="joinOnlineRoomById('${r.id}')" class="px-3 py-1 bg-cyan-400 hover:bg-cyan-300 text-black font-black text-xs rounded-lg">
                            ${currentLang === 'en' ? 'JOIN' : '参加する'}
                        </button>
                    `;
                    listEl.appendChild(row);
                });
            });
        }

        async function createOnlineRoom() {
            const pvp = window.FirebasePvP;
            if (!pvp || !pvp.ready || !pvp.db) {
                showOnlineBanner('Firebase接続が完了していないためルームを作成できません。', true);
                return;
            }

            const code = String(Math.floor(1000 + Math.random() * 9000));
            const { doc, setDoc, onSnapshot } = pvp.fns;
            const roomRef = doc(pvp.db, 'artifacts', pvp.appId, 'public', 'data', 'pvp_rooms', code);

            try {
                await setDoc(roomRef, {
                    status: 'waiting',
                    hostUid: pvp.user.uid,
                    guestUid: null,
                    createdAt: Date.now(),
                    scoreRed: 0,
                    scoreBlue: 0,
                    matchTimeSeconds: 0,
                    hasBallPossession: true,
                    isBallInFlight: false,
                    ball: { x: 0, y: 0.75, z: 0 },
                    redPlayers: [],
                    bluePlayers: [],
                    guestInput: guestLatestInput
                });

                currentOnlineRoomId = code;
                onlineRole = 'host';

                const codeEl = document.getElementById('createdRoomCodeText');
                const statusEl = document.getElementById('hostWaitStatusText');
                const createBtn = document.getElementById('createRoomBtn');
                const copyBtn = document.getElementById('copyRoomCodeBtn');
                const cancelBtn = document.getElementById('cancelRoomBtn');

                if (codeEl) codeEl.innerText = code;
                if (statusEl) statusEl.innerText = currentLang === 'en' ? 'Waiting for opponent to join...' : '対戦相手の参加を待機中...';
                if (createBtn) createBtn.classList.add('hidden');
                if (copyBtn) copyBtn.classList.remove('hidden');
                if (cancelBtn) cancelBtn.classList.remove('hidden');

                if (roomUnsubscribe) roomUnsubscribe();
                roomUnsubscribe = onSnapshot(roomRef, (snap) => {
                    if (!snap.exists()) return;
                    const data = snap.data();
                    if (data.status === 'playing' && !isMatchRunning) {
                        startOnlineMatchClient('host', code);
                    } else if (data.status === 'playing' && isMatchRunning && data.guestInput) {
                        applyGuestInputOnHost(data.guestInput);
                    }
                });
            } catch (err) {
                showOnlineBanner('ルーム作成に失敗しました: ' + (err.message || ''), true);
            }
        }

