        // =========================================================================
        // 4. MY TEAM FORMATION & SQUAD MANAGEMENT
        // =========================================================================
        function isPlayerCompatibleWithPos(player, slotPos) {
            if (!player || !slotPos) return true;
            return player.pos === slotPos || (Array.isArray(player.compat) && player.compat.includes(slotPos));
        }

        function getEffectivePlayerStats(player, slotPos) {
            if (!player) return { ovr: 60, spd: 60, drb: 60, isCompat: false, kickMult: 0.72 };
            const isCompat = isPlayerCompatibleWithPos(player, slotPos);
            if (isCompat) {
                return {
                    ovr: player.ovr,
                    spd: player.spd,
                    drb: player.drb,
                    isCompat: true,
                    kickMult: 1.0
                };
            }
            // ポジション適性がない場合は能力値を大幅にダウン
            return {
                ovr: Math.max(40, player.ovr - 25),
                spd: Math.max(40, Math.round(player.spd * 0.68)),
                drb: Math.max(40, Math.round(player.drb * 0.62)),
                isCompat: false,
                kickMult: 0.72
            };
        }

        function changeFormation(newFormation) {
            if (!formationTemplates[newFormation]) return;
            currentFormation = newFormation;
            selectedSwapIndex = null;
            renderMyTeamPitch();
            if (window.saveCloudData) window.saveCloudData(true);
        }

        function autoSelectSquad() {
            const template = formationTemplates[currentFormation] || formationTemplates['433'];
            const allPlayers = [...myTeamSquad, ...reservePlayers];
            const usedIndices = new Set();
            const newStarters = [];

            template.forEach(slot => {
                let bestIdx = -1;
                let bestScore = -999;

                allPlayers.forEach((p, idx) => {
                    if (usedIndices.has(idx)) return;
                    const eff = getEffectivePlayerStats(p, slot.pos);
                    const effectiveOvr = eff.isCompat ? eff.ovr + (p.pos === slot.pos ? 2 : 0) : eff.ovr;
                    if (effectiveOvr > bestScore) {
                        bestScore = effectiveOvr;
                        bestIdx = idx;
                    }
                });

                if (bestIdx !== -1) {
                    usedIndices.add(bestIdx);
                    newStarters.push(allPlayers[bestIdx]);
                }
            });

            const newReserves = allPlayers.filter((_, idx) => !usedIndices.has(idx));
            myTeamSquad = newStarters;
            reservePlayers = newReserves;
            selectedSwapIndex = null;
            renderMyTeamPitch();
            if (window.saveCloudData) window.saveCloudData(true);
        }

        function renderMyTeamPitch() {
            const pitchContainer = document.getElementById('formationPitchNode');
            const benchContainer = document.getElementById('benchList');
            const template = formationTemplates[currentFormation] || formationTemplates['433'];
            if (!pitchContainer || !benchContainer) return;

            pitchContainer.innerHTML = '';
            let totalOvr = 0;

            // 現在入れ替え選択中の選手（適正ポジションを光らせるガイド用）
            const selectedPlayerObj = selectedSwapIndex !== null
                ? (selectedSwapIndex < 11 ? myTeamSquad[selectedSwapIndex] : reservePlayers[selectedSwapIndex - 11])
                : null;

            myTeamSquad.forEach((p, idx) => {
                const slot = template[idx] || { pos: p.pos, x: 50, y: 50 };
                const eff = getEffectivePlayerStats(p, slot.pos);
                const isCompat = eff.isCompat;
                const effectiveOvr = eff.ovr;
                totalOvr += effectiveOvr;

                const style = getRarityStyle(p.rarity);
                const isSelected = selectedSwapIndex === idx;
                const isTargetSlotCompat = selectedPlayerObj && isPlayerCompatibleWithPos(selectedPlayerObj, slot.pos);

                // レアリティ背景デザイン
                let cardBg = 'bg-slate-900/95';
                if (p.rarity === 'Big Time') {
                    cardBg = 'bg-gradient-to-b from-amber-800/95 via-amber-950/95 to-slate-950';
                } else if (p.rarity === 'Epic') {
                    cardBg = 'bg-gradient-to-b from-emerald-800/95 via-emerald-950/95 to-slate-950';
                } else if (p.rarity === 'Show Time') {
                    cardBg = 'bg-gradient-to-b from-cyan-800/95 via-blue-950/95 to-slate-950';
                } else if (p.rarity === 'Highlight') {
                    cardBg = 'bg-gradient-to-b from-purple-900/90 to-slate-950';
                }

                // 適正ポジション発光エフェクト
                let compatGlowClass = '';
                if (isCompat) {
                    compatGlowClass = 'border-2 border-lime-400 ring-2 ring-lime-400/70 shadow-[0_0_24px_rgba(163,230,53,0.95)]';
                } else {
                    compatGlowClass = 'border-2 border-red-500/80 opacity-80';
                }

                // 入れ替え選択中の選手に対する適正枠ハイライト
                if (isTargetSlotCompat && !isSelected) {
                    compatGlowClass += ' animate-pulse ring-4 ring-yellow-300';
                }

                const posBadgeClass = isCompat
                    ? 'bg-lime-400 text-black px-1.5 py-0.2 rounded shadow-[0_0_8px_rgba(163,230,53,0.9)]'
                    : 'bg-red-600 text-white px-1.5 py-0.2 rounded';

                const node = document.createElement('div');
                node.style.left = `${slot.x}%`;
                node.style.top = `${slot.y}%`;
                node.className = `absolute -translate-x-1/2 -translate-y-1/2 pointer-events-auto cursor-pointer flex flex-col items-center transition-transform hover:scale-110 ${isSelected ? 'player-selected z-20' : 'z-10'}`;
                node.onclick = () => handlePlayerSwapTap(idx);

                node.innerHTML = `
                    <div class="w-13 h-13 px-1.5 py-1 rounded-2xl ${cardBg} ${compatGlowClass} flex flex-col items-center justify-center relative">
                        <span class="text-[9px] font-black ${posBadgeClass} leading-none mb-0.5">${slot.pos}</span>
                        <span class="ef-font text-xl font-black ${isCompat ? 'text-white' : 'text-red-400'} leading-none">${effectiveOvr}</span>
                        ${['Big Time', 'Epic', 'Show Time'].includes(p.rarity)
                            ? `<span class="absolute -top-2 -right-2 text-[8px] font-black px-1 rounded ${style.badge}">${style.short}</span>`
                            : ''}
                    </div>
                    <div class="mt-1 px-2 py-0.5 rounded-md bg-slate-950/95 border ${isCompat ? 'border-lime-400/60 text-lime-200' : 'border-red-500/60 text-red-300'} text-[10px] font-extrabold whitespace-nowrap shadow">
                        ${getDisplayPlayerName(p.name)}
                    </div>
                `;
                pitchContainer.appendChild(node);
            });

            // チームパワー算出
            const strengthEl = document.getElementById('teamStrength');
            if (strengthEl) strengthEl.innerText = Math.round(totalOvr * 3.35);

            // ベンチリスト描画
            benchContainer.innerHTML = '';
            const subCountEl = document.getElementById('subCount');
            if (subCountEl) subCountEl.innerText = reservePlayers.length;

            reservePlayers.forEach((p, rIdx) => {
                const globalIdx = 11 + rIdx;
                const isSelected = selectedSwapIndex === globalIdx;
                const style = getRarityStyle(p.rarity);

                let benchGlow = 'border-gray-700 bg-slate-900/80';
                if (p.rarity === 'Big Time') {
                    benchGlow = 'border-amber-300 shadow-[0_0_15px_rgba(251,191,36,0.6)] bg-gradient-to-r from-amber-950/80 to-slate-900';
                } else if (p.rarity === 'Epic') {
                    benchGlow = 'border-emerald-400 shadow-[0_0_15px_rgba(52,211,153,0.6)] bg-gradient-to-r from-emerald-950/80 to-slate-900';
                } else if (p.rarity === 'Show Time') {
                    benchGlow = 'border-cyan-400 shadow-[0_0_15px_rgba(34,211,238,0.6)] bg-gradient-to-r from-cyan-950/80 to-slate-900';
                }

                const row = document.createElement('div');
                row.className = `flex items-center justify-between px-3 py-2 rounded-xl border ${benchGlow} cursor-pointer hover:border-cyan-400 transition-all ${isSelected ? 'player-selected' : ''}`;
                row.onclick = () => handlePlayerSwapTap(globalIdx);

                row.innerHTML = `
                    <div class="flex items-center space-x-2">
                        <span class="w-8 text-center text-[10px] font-black bg-slate-800 text-cyan-300 py-0.5 rounded">${p.pos}</span>
                        <span class="font-extrabold text-white">${getDisplayPlayerName(p.name)}</span>
                        ${['Big Time', 'Epic', 'Show Time'].includes(p.rarity)
                            ? `<span class="text-[9px] font-black px-1.5 py-0.2 rounded ${style.badge}">${p.rarity.toUpperCase()}</span>`
                            : ''}
                    </div>
                    <div class="flex items-center space-x-3">
                        <span class="text-[10px] text-gray-400">SPD ${p.spd} / DRB ${p.drb}</span>
                        <span class="ef-font text-xl font-black text-ef-yellow">${p.ovr}</span>
                    </div>
                `;
                benchContainer.appendChild(row);
            });
        }

        function handlePlayerSwapTap(index) {
            if (selectedSwapIndex === null) {
                selectedSwapIndex = index;
                renderMyTeamPitch();
                return;
            }
            if (selectedSwapIndex === index) {
                selectedSwapIndex = null;
                renderMyTeamPitch();
                return;
            }

            const getPlayer = (idx) => idx < 11 ? myTeamSquad[idx] : reservePlayers[idx - 11];
            const setPlayer = (idx, val) => {
                if (idx < 11) myTeamSquad[idx] = val;
                else reservePlayers[idx - 11] = val;
            };

            const temp = getPlayer(selectedSwapIndex);
            setPlayer(selectedSwapIndex, getPlayer(index));
            setPlayer(index, temp);

            selectedSwapIndex = null;
            renderMyTeamPitch();
            if (window.saveCloudData) window.saveCloudData(true);
        }

        // =========================================================================
        // 5. 3D MATCH ENGINE (TV BROADCAST CAMERA, PHYSICS, AI & RULES)
        // =========================================================================
        function init3DScene() {
            const canvas = document.getElementById('gameCanvas');
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x09131f);
            scene.fog = new THREE.Fog(0x09131f, 140, 280);

            camera = new THREE.PerspectiveCamera(44, window.innerWidth / window.innerHeight, 0.1, 500);
            // TV中継サイドビューカメラ (+X側のタッチライン上からピッチ横視点で俯瞰)
            camera.position.set(92, 58, 0);
            camera.lookAt(0, 0, 0);

            renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            // ライティング
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.72);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xffffff, 0.85);
            dirLight.position.set(60, 110, 40);
            scene.add(dirLight);

            // ピッチ芝生 (幅130 x 長さ210)
            const pitchGeo = new THREE.PlaneGeometry(130, 210);
            const pitchMat = new THREE.MeshLambertMaterial({ color: 0x1b6e32 });
            const pitch = new THREE.Mesh(pitchGeo, pitchMat);
            pitch.rotation.x = -Math.PI / 2;
            scene.add(pitch);

            // 芝生ストライプ模様
            for (let z = -90; z <= 90; z += 20) {
                const stripeGeo = new THREE.PlaneGeometry(120, 10);
                const stripeMat = new THREE.MeshLambertMaterial({ color: 0x207d39 });
                const stripe = new THREE.Mesh(stripeGeo, stripeMat);
                stripe.rotation.x = -Math.PI / 2;
                stripe.position.set(0, 0.02, z);
                scene.add(stripe);
            }

            // ピッチ白線
            const lineMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
            function addLine(w, d, x, z) {
                const m = new THREE.Mesh(new THREE.PlaneGeometry(w, d), lineMat);
                m.rotation.x = -Math.PI / 2;
                m.position.set(x, 0.05, z);
                scene.add(m);
            }
            addLine(120, 0.6, 0, -100); // 相手ゴールライン
            addLine(120, 0.6, 0, 100);  // 自陣ゴールライン
            addLine(0.6, 200, -60, 0);  // 奥タッチライン
            addLine(0.6, 200, 60, 0);   // 手前タッチライン
            addLine(120, 0.6, 0, 0);    // ハーフウェーライン

            // センターサークル
            const circleGeo = new THREE.RingGeometry(11.5, 12.1, 48);
            const circleMesh = new THREE.Mesh(circleGeo, lineMat);
            circleMesh.rotation.x = -Math.PI / 2;
            circleMesh.position.set(0, 0.05, 0);
            scene.add(circleMesh);

            // ペナルティエリア
            addLine(44, 0.6, 0, -78);
            addLine(0.6, 22, -22, -89);
            addLine(0.6, 22, 22, -89);
            addLine(44, 0.6, 0, 78);
            addLine(0.6, 22, -22, 89);
            addLine(0.6, 22, 22, 89);

            // 3Dゴールポスト構築
            createGoalPosts(-100);
            createGoalPosts(100);

            // 3Dサッカーボール生成
            ball = new THREE.Mesh(
                new THREE.SphereGeometry(0.75, 20, 20),
                new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.35 })
            );
            ball.position.set(0, 0.75, 0);
            scene.add(ball);

            // GKセーブ後のパス先選択ターゲット表示リング
            gkTargetRing = new THREE.Mesh(
                new THREE.RingGeometry(1.55, 2.15, 32),
                new THREE.MeshBasicMaterial({ color: 0xccff00, side: THREE.DoubleSide, transparent: true, opacity: 0.95 })
            );
            gkTargetRing.rotation.x = -Math.PI / 2;
            gkTargetRing.position.y = 0.09;
            gkTargetRing.visible = false;
            scene.add(gkTargetRing);

            // フリーキック照準ガイドライン（キッカーからターゲット地点への方向指示）
            fkAimLine = new THREE.Mesh(
                new THREE.PlaneGeometry(0.45, 1),
                new THREE.MeshBasicMaterial({ color: 0xccff00, side: THREE.DoubleSide, transparent: true, opacity: 0.72 })
            );
            fkAimLine.rotation.x = -Math.PI / 2;
            fkAimLine.position.y = 0.08;
            fkAimLine.visible = false;
            scene.add(fkAimLine);

            createTeamPlayers();
            window.addEventListener('resize', onWindowResize);
            window.addEventListener('orientationchange', () => setTimeout(onWindowResize, 120));
        }

        function createGoalPosts(zPos) {
            const postMat = new THREE.MeshStandardMaterial({ color: 0xffffff });
            const netMat = new THREE.MeshBasicMaterial({ color: 0xcccccc, wireframe: true, transparent: true, opacity: 0.35 });

            const leftPost = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.22, 4.2), postMat);
            leftPost.position.set(-7.5, 2.1, zPos);
            scene.add(leftPost);

            const rightPost = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.22, 4.2), postMat);
            rightPost.position.set(7.5, 2.1, zPos);
            scene.add(rightPost);

            const crossbar = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.22, 15.2), postMat);
            crossbar.rotation.z = Math.PI / 2;
            crossbar.position.set(0, 4.2, zPos);
            scene.add(crossbar);

            const netDepth = zPos < 0 ? -3.0 : 3.0;
            const netBox = new THREE.Mesh(new THREE.BoxGeometry(15.0, 4.2, 3.0), netMat);
            netBox.position.set(0, 2.1, zPos + netDepth / 2);
            scene.add(netBox);
        }

        function buildPlayerMesh(kitColorHex, isGk) {
            const group = new THREE.Group();
            const kitColor = isGk ? 0xfacc15 : kitColorHex;

            // 胴体
            const torso = new THREE.Mesh(
                new THREE.BoxGeometry(1.3, 1.8, 0.8),
                new THREE.MeshLambertMaterial({ color: kitColor })
            );
            torso.position.y = 2.1;
            group.add(torso);

            // 頭部
            const head = new THREE.Mesh(
                new THREE.SphereGeometry(0.52, 12, 12),
                new THREE.MeshLambertMaterial({ color: 0xf1c27d })
            );
            head.position.y = 3.45;
            group.add(head);

            // 左脚・右脚
            const legGeo = new THREE.BoxGeometry(0.45, 1.3, 0.5);
            const legMat = new THREE.MeshLambertMaterial({ color: 0x111827 });

            const legL = new THREE.Mesh(legGeo, legMat);
            legL.name = 'legL';
            legL.position.set(-0.35, 0.65, 0);
            group.add(legL);

            const legR = new THREE.Mesh(legGeo, legMat);
            legR.name = 'legR';
            legR.position.set(0.35, 0.65, 0);
            group.add(legR);

            // 操作カーソルリング (足元)
            const ring = new THREE.Mesh(
                new THREE.RingGeometry(1.1, 1.45, 24),
                new THREE.MeshBasicMaterial({ color: 0x00f0ff, side: THREE.DoubleSide })
            );
            ring.name = 'cursorRing';
            ring.rotation.x = -Math.PI / 2;
            ring.position.y = 0.08;
            ring.visible = false;
            group.add(ring);

            // ダッシュ専用スピードオーラリング (足元外周)
            const dashRing = new THREE.Mesh(
                new THREE.RingGeometry(1.65, 2.25, 28),
                new THREE.MeshBasicMaterial({ color: 0xffaa00, side: THREE.DoubleSide, transparent: true, opacity: 0.85 })
            );
            dashRing.name = 'dashRing';
            dashRing.rotation.x = -Math.PI / 2;
            dashRing.position.y = 0.07;
            dashRing.visible = false;
            group.add(dashRing);

            return group;
        }

        function createTeamPlayers() {
            if (!scene) return;
            redTeamPlayers.forEach(p => scene.remove(p));
            blueTeamPlayers.forEach(p => scene.remove(p));
            redTeamPlayers = [];
            blueTeamPlayers = [];

            for (let i = 0; i < 11; i++) {
                const redMesh = buildPlayerMesh(0xdc2626, i === 0);
                scene.add(redMesh);
                redTeamPlayers.push(redMesh);

                const blueMesh = buildPlayerMesh(0x2563eb, i === 0);
                scene.add(blueMesh);
                blueTeamPlayers.push(blueMesh);
            }
        }

        // =========================================================================
        // 6. MAIN 3D MATCH ANIMATION LOOP
        // =========================================================================
        function animateMatch() {
            if (!isMatchRunning) return;
            animationFrameId = requestAnimationFrame(animateMatch);
            if (!ball) return;

            const now = Date.now();
            const isGuestClient = isOnlineMatch && onlineRole === 'guest';
            const myTeamArr = isGuestClient ? blueTeamPlayers : redTeamPlayers;
            const oppTeamArr = isGuestClient ? redTeamPlayers : blueTeamPlayers;
            const activePlayer = myTeamArr[controlledPlayerIndex];
            const isMovingInput = Math.hypot(inputVector.x, inputVector.z) > 0.05;

            // カーソルリング＆ダッシュオーラ更新（ダッシュ中はゴールド発光＆パルス拡大）
            redTeamPlayers.forEach((p, idx) => {
                const ring = p.getObjectByName('cursorRing');
                const dashRing = p.getObjectByName('dashRing');
                const isThisActive = !isGuestClient && (idx === controlledPlayerIndex);
                const isDashingNow = isThisActive && isDashPressed && isMovingInput;

                if (ring) {
                    ring.visible = isThisActive;
                    if (isThisActive && ring.material) {
                        if (isDashingNow) {
                            ring.material.color.setHex(0xffcc00);
                            ring.scale.set(1.18, 1.18, 1);
                        } else {
                            ring.material.color.setHex(isMatchUpHeld ? 0xccff00 : 0x00f0ff);
                            ring.scale.set(1, 1, 1);
                        }
                    }
                }
                if (dashRing) {
                    dashRing.visible = isDashingNow;
                    if (isDashingNow) {
                        const pulse = 1.0 + ((now % 320) / 320) * 0.45;
                        dashRing.scale.set(pulse, pulse, 1);
                        dashRing.material.opacity = 0.9 - ((now % 320) / 320) * 0.65;
                    }
                }
            });

            blueTeamPlayers.forEach((p, idx) => {
                const ring = p.getObjectByName('cursorRing');
                const dashRing = p.getObjectByName('dashRing');
                const isThisActive = isGuestClient && (idx === controlledPlayerIndex);
                const isDashingNow = isThisActive && isDashPressed && isMovingInput;

                if (ring) {
                    ring.visible = isThisActive;
                    if (isThisActive && ring.material) {
                        if (isDashingNow) {
                            ring.material.color.setHex(0xffcc00);
                            ring.scale.set(1.18, 1.18, 1);
                        } else {
                            ring.material.color.setHex(isMatchUpHeld ? 0xccff00 : 0x00f0ff);
                            ring.scale.set(1, 1, 1);
                        }
                    }
                }
                if (dashRing) {
                    dashRing.visible = isDashingNow;
                    if (isDashingNow) {
                        const pulse = 1.0 + ((now % 320) / 320) * 0.45;
                        dashRing.scale.set(pulse, pulse, 1);
                        dashRing.material.opacity = 0.9 - ((now % 320) / 320) * 0.65;
                    }
                }
            });

            // キックオフ1秒待機、ゴール待機、GKセーブ待機、オフサイド停止中は物理更新を停止
            if (!isKickoffWait && !isGoalPause && !isGkSaving && !isOffsideFlagged) {
                // TV中継サイドビューのスティック入力をワールド座標へ変換（Hostは+X視点、Guestは-X視点で共に左→右へ攻撃）
                const worldMoveX = isGuestClient ? -inputVector.z : inputVector.z;
                const worldMoveZ = isGuestClient ? inputVector.x : -inputVector.x;
                const inputMag = Math.hypot(worldMoveX, worldMoveZ);

                if (isKickoff && inputMag > 0.1) {
                    isKickoff = false;
                    const kb = document.getElementById('kickoffBanner');
                    if (kb) kb.classList.add('opacity-0');
                }

                // GKセーブ後のパス先選択モード処理
                if (isGkHoldingBall && !isGuestClient) {
                    updateGkDistributionMode(now, worldMoveX, worldMoveZ, inputMag);
                    updateAiPlayersPosition(now);
                } else if (isFreeKickHolding && !isGuestClient) {
                    updateFreeKickDistributionMode(now, worldMoveX, worldMoveZ, inputMag);
                    updateAiPlayersPosition(now);
                } else {
                // 操作プレイヤーの移動処理（通常ジョグとダッシュスプリントの明確な差別化）
                if (activePlayer && inputMag > 0.05) {
                    const slotTemplate = formationTemplates[currentFormation] || formationTemplates['433'];
                    const currentSlotPos = (slotTemplate[controlledPlayerIndex] || {}).pos;
                    const pStats = getEffectivePlayerStats(myTeamSquad[controlledPlayerIndex], currentSlotPos);
                    const spd = pStats.spd;
                    const drb = pStats.drb;

                    // 通常移動は細かいコントロール重視の速度、ダッシュは一気に加速するスプリント速度
                    const baseSpeed = 0.105 + (spd / 100) * 0.165;
                    const dashMultiplier = isDashPressed ? 1.62 : 1.0;
                    const moveSpeed = baseSpeed * dashMultiplier;

                    let nx = worldMoveX / inputMag;
                    let nz = worldMoveZ / inputMag;

                    // 守備時マッチアップ長押し中はボール保持者方向へ軽くコース補正
                    if (!hasBallPossession && isMatchUpHeld && ball) {
                        const toBallX = ball.position.x - activePlayer.position.x;
                        const toBallZ = ball.position.z - activePlayer.position.z;
                        const bDist = Math.hypot(toBallX, toBallZ) || 1;
                        nx = nx * 0.55 + (toBallX / bDist) * 0.45;
                        nz = nz * 0.55 + (toBallZ / bDist) * 0.45;
                        const nLen = Math.hypot(nx, nz) || 1;
                        nx /= nLen;
                        nz /= nLen;
                    }

                    activePlayer.position.x = Math.max(-59, Math.min(59, activePlayer.position.x + nx * moveSpeed));
                    activePlayer.position.z = Math.max(-99, Math.min(99, activePlayer.position.z + nz * moveSpeed));
                    activePlayer.rotation.y = (!hasBallPossession && isMatchUpHeld && ball)
                        ? Math.atan2(ball.position.x - activePlayer.position.x, ball.position.z - activePlayer.position.z)
                        : Math.atan2(nx, nz);

                    // ダッシュ時は前傾スプリント姿勢・高速ストライド、通常時は直立・小刻みステップ
                    activePlayer.rotation.x = isDashPressed ? 0.22 : 0;

                    const legL = activePlayer.getObjectByName('legL');
                    const legR = activePlayer.getObjectByName('legR');
                    if (legL && legR) {
                        const swingFreq = isDashPressed ? 0.038 : 0.017;
                        const swingAmp = isDashPressed ? 1.05 : 0.52;
                        const swing = Math.sin(now * swingFreq) * swingAmp;
                        legL.rotation.x = swing;
                        legR.rotation.x = -swing;
                    }

                    // ボール保持中のドリブルタッチ制御（ボールが離れすぎた場合は勝手に引き戻さずルーズボール化）
                    if (hasBallPossession && !isBallInFlight && !isGuestClient) {
                        const distToBallNow = Math.hypot(ball.position.x - activePlayer.position.x, ball.position.z - activePlayer.position.z);
                        if (distToBallNow > 3.6) {
                            hasBallPossession = false;
                            playerDribbleTouchCount = 0;
                            playerDribbleFrameCounter = 0;
                        } else {
                            playerDribbleFrameCounter++;
                            if (playerDribbleFrameCounter % 20 === 0) {
                                playerDribbleTouchCount++;
                            }

                            let drbDist = 0.58 + ((100 - drb) / 100) * 1.65;
                            let dribbleControl = Math.min(0.52, 0.16 + (drb / 200));

                            if (isDashPressed) {
                                drbDist *= 1.48;
                                dribbleControl *= 0.85;
                            }

                            if (playerDribbleTouchCount >= 3) {
                                drbDist *= 2.4;
                                dribbleControl *= 0.33;
                            }

                            const targetBallX = activePlayer.position.x + nx * drbDist;
                            const targetBallZ = activePlayer.position.z + nz * drbDist;
                            let stepX = (targetBallX - ball.position.x) * dribbleControl;
                            let stepZ = (targetBallZ - ball.position.z) * dribbleControl;

                            // 相手から奪取・トラップ直後は最大移動量を制限し、ボールの瞬間移動を防止
                            if (now - lastPossessionChangeTime < 320) {
                                const stepLen = Math.hypot(stepX, stepZ);
                                const maxTrapStep = 0.42;
                                if (stepLen > maxTrapStep) {
                                    stepX = (stepX / stepLen) * maxTrapStep;
                                    stepZ = (stepZ / stepLen) * maxTrapStep;
                                }
                            }

                            ball.position.x += stepX;
                            ball.position.z += stepZ;
                            ball.position.y = 0.75;
                        }
                    }
                } else if (activePlayer) {
                    activePlayer.rotation.x = 0;
                    const legL = activePlayer.getObjectByName('legL');
                    const legR = activePlayer.getObjectByName('legR');
                    if (legL && legR) {
                        legL.rotation.x = 0;
                        legR.rotation.x = 0;
                    }

                    // 静止中はボールを勝手に選手へ引き戻さず、離れている場合はルーズボール扱いにする
                    if (hasBallPossession && !isBallInFlight && !isKickoff && ball && !isGuestClient) {
                        const dist = Math.hypot(ball.position.x - activePlayer.position.x, ball.position.z - activePlayer.position.z);
                        if (dist > 2.4) {
                            hasBallPossession = false;
                            playerDribbleTouchCount = 0;
                            playerDribbleFrameCounter = 0;
                        }
                    }

                    // 守備時にスティック無入力でもマッチアップ長押し中はボール保持者へ自動で間合いを詰める
                    if (!hasBallPossession && !isBallInFlight && isMatchUpHeld && ball) {
                        const dx = ball.position.x - activePlayer.position.x;
                        const dz = (ball.position.z + (isGuestClient ? -1.1 : 1.1)) - activePlayer.position.z;
                        const dist = Math.hypot(dx, dz);
                        activePlayer.rotation.y = Math.atan2(ball.position.x - activePlayer.position.x, ball.position.z - activePlayer.position.z);
                        if (dist > 0.3) {
                            const slideSpeed = 0.24;
                            const step = Math.min(dist, slideSpeed);
                            activePlayer.position.x += (dx / dist) * step;
                            activePlayer.position.z += (dz / dist) * step;
                        }
                    }
                }

                // ゲストクライアントの場合はホストからの最新状態受信と自分の入力送信のみ行う
                if (!isGuestClient) {
                    // ボール飛行中（パス・スルーパス・シュート）の物理＆トラップ・カット・GKセーブ判定
                    if (isBallInFlight && ball) {
                        const prevX = ball.position.x;
                        const prevZ = ball.position.z;

                        ball.position.x += ballVel.x;
                        ball.position.z += ballVel.z;
                        ball.position.y = Math.max(0.75, ball.position.y + ballVel.y);
                        ballVel.y -= 0.012;
                        if (ball.position.y <= 0.75) {
                            ball.position.y = 0.75;
                            ballVel.y = 0;
                        }

                        // 芝生摩擦による減速（前回のスピード感に復元）
                        ballVel.x *= 0.988;
                        ballVel.z *= 0.988;

                        const midX = (prevX + ball.position.x) * 0.5;
                        const midZ = (prevZ + ball.position.z) * 0.5;

                        // 味方GK (redTeamPlayers[0]) 物理接触セーブ判定
                        if (redTeamPlayers[0] && ballVel.z > 0 && ball.position.z > 88) {
                            const gk = redTeamPlayers[0];
                            const dEnd = Math.hypot(gk.position.x - ball.position.x, gk.position.z - ball.position.z);
                            const dMid = Math.hypot(gk.position.x - midX, gk.position.z - midZ);
                            if (Math.min(dEnd, dMid) < 2.25 && ball.position.y < 4.1) {
                                triggerNiceSave(gk, false);
                            }
                        }

                        // 相手GK (blueTeamPlayers[0]) 物理接触セーブ判定
                        if (!isGkSaving && blueTeamPlayers[0] && ballVel.z < 0 && ball.position.z < -88) {
                            const gk = blueTeamPlayers[0];
                            const dEnd = Math.hypot(gk.position.x - ball.position.x, gk.position.z - ball.position.z);
                            const dMid = Math.hypot(gk.position.x - midX, gk.position.z - midZ);
                            if (Math.min(dEnd, dMid) < 2.25 && ball.position.y < 4.1) {
                                triggerNiceSave(gk, true);
                            }
                        }

                        // 味方フィールド選手のパス受け取り＆インターセプト判定
                        if (!isGkSaving && !isOffsideFlagged) {
                            for (let i = 1; i < redTeamPlayers.length; i++) {
                                if (lastPasserTeam === 'red' && i === lastPasserIndex && now - lastPassTime < 750) continue;
                                const mate = redTeamPlayers[i];
                                const dist = Math.hypot(mate.position.x - ball.position.x, mate.position.z - ball.position.z);
                                const interceptRadius = (lastPasserTeam !== 'red' && i === controlledPlayerIndex && isMatchUpHeld) ? 2.65 : 2.15;

                                if (dist < interceptRadius && ball.position.y < 2.8) {
                                    // オフサイドポジションでの受け取りチェック
                                    if (lastPasserTeam === 'red' && offsidePlayerIndices.includes(i)) {
                                        triggerOffside(true);
                                        break;
                                    }
                                    controlledPlayerIndex = i;
                                    hasBallPossession = true;
                                    isBallInFlight = false;
                                    passTargetTeam = null;
                                    passTargetPlayerIndex = -1;
                                    isThroughPassInFlight = false;
                                    ballVel = { x: 0, z: 0, y: 0 };
                                    lastPossessionChangeTime = now;
                                    playerDribbleTouchCount = 0;
                                    playerDribbleFrameCounter = 0;
                                    offsidePlayerIndices = [];
                                    break;
                                }
                            }
                        }

                        // 相手CPUフィールド選手のパス受け取り＆インターセプト判定
                        if (isBallInFlight && !isGkSaving && !isOffsideFlagged) {
                            for (let i = 1; i < blueTeamPlayers.length; i++) {
                                if (lastPasserTeam === 'blue' && i === lastPasserIndex && now - lastPassTime < 450) continue;
                                // CPUのシュート直後に味方CPUが自分のシュートをトラップして止める誤作動を防止
                                if (lastPasserTeam === 'blue' && passTargetTeam === null && now - lastPassTime < 300) continue;
                                const cpu = blueTeamPlayers[i];
                                const dist = Math.hypot(cpu.position.x - ball.position.x, cpu.position.z - ball.position.z);
                                const isGuestControlled = isOnlineMatch && (i === (guestLatestInput.controlledIdx || 10));
                                const interceptRadius = (lastPasserTeam !== 'blue' && isGuestControlled && guestLatestInput.isMatchUp) ? 2.65 : 2.15;

                                if (dist < interceptRadius && ball.position.y < 2.8) {
                                    if (lastPasserTeam === 'blue' && cpuOffsidePlayerIndices.includes(i)) {
                                        triggerOffside(false);
                                        break;
                                    }
                                    hasBallPossession = false;
                                    isBallInFlight = false;
                                    passTargetTeam = null;
                                    passTargetPlayerIndex = -1;
                                    isThroughPassInFlight = false;
                                    ballVel = { x: 0, z: 0, y: 0 };
                                    lastPossessionChangeTime = now;
                                    cpuDribbleTouchCount = 0;
                                    cpuDribbleFrameCounter = 0;
                                    cpuOffsidePlayerIndices = [];
                                    break;
                                }
                            }
                        }

                        // ボールがほぼ停止したらルーズボール化
                        if (isBallInFlight && Math.hypot(ballVel.x, ballVel.z) < 0.06) {
                            isBallInFlight = false;
                            passTargetTeam = null;
                            passTargetPlayerIndex = -1;
                            isThroughPassInFlight = false;
                            ballVel = { x: 0, z: 0, y: 0 };
                        }
                    } else if (!isBallInFlight && !isKickoff && ball) {
                        // ドリブル中・ルーズボール時の攻守奪取判定（プレイヤーとCPU/Guestで完全対等な判定距離）
                        if (hasBallPossession && now - lastPossessionChangeTime > 450) {
                            // Blue側守備者によるボール奪取判定
                            for (let i = 1; i < blueTeamPlayers.length; i++) {
                                if (now < cpuTackleCooldowns[i]) continue;
                                const cpu = blueTeamPlayers[i];
                                const isGuestControlled = isOnlineMatch && (i === (guestLatestInput.controlledIdx || 10));
                                const bRad = (isGuestControlled && guestLatestInput.isMatchUp) ? 2.45 : 2.15;
                                const cRad = (isGuestControlled && guestLatestInput.isMatchUp) ? 2.15 : 1.95;

                                const dBall = Math.hypot(cpu.position.x - ball.position.x, cpu.position.z - ball.position.z);
                                const dCarrier = activePlayer
                                    ? Math.hypot(cpu.position.x - activePlayer.position.x, cpu.position.z - activePlayer.position.z)
                                    : 999;
                                if (dBall < bRad || dCarrier < cRad) {
                                    hasBallPossession = false;
                                    lastPossessionChangeTime = now;
                                    playerTackleCooldowns[controlledPlayerIndex] = now + 650;
                                    cpuDribbleTouchCount = 0;
                                    cpuDribbleFrameCounter = 0;
                                    break;
                                }
                            }
                        } else if (!hasBallPossession && now - lastPossessionChangeTime > 350) {
                            // Red側操作選手（およびゴール前カバーの味方DF）によるボール奪取判定
                            const stealBallRadius = isMatchUpHeld ? 2.45 : 2.05;
                            const stealCarrierRadius = isMatchUpHeld ? 2.15 : 1.85;

                            for (let i = 1; i < redTeamPlayers.length; i++) {
                                if (now < playerTackleCooldowns[i]) continue;
                                const redP = redTeamPlayers[i];
                                const isUserControlled = (i === controlledPlayerIndex);
                                const rBall = isUserControlled ? stealBallRadius : 1.95;
                                const rCarrier = isUserControlled ? stealCarrierRadius : 1.75;

                                const dBall = Math.hypot(redP.position.x - ball.position.x, redP.position.z - ball.position.z);
                                let closeCarrier = false;
                                for (let b = 1; b < blueTeamPlayers.length; b++) {
                                    if (Math.hypot(redP.position.x - blueTeamPlayers[b].position.x, redP.position.z - blueTeamPlayers[b].position.z) < rCarrier) {
                                        closeCarrier = true;
                                        break;
                                    }
                                }

                                if (dBall < rBall || (closeCarrier && dBall < rBall + 0.35)) {
                                    controlledPlayerIndex = i;
                                    hasBallPossession = true;
                                    lastPossessionChangeTime = now;
                                    for (let k = 0; k < 11; k++) {
                                        cpuTackleCooldowns[k] = now + 550;
                                    }
                                    playerDribbleTouchCount = 0;
                                    playerDribbleFrameCounter = 0;
                                    break;
                                }
                            }
                        }
                    }

                    // AI選手ポジショニング更新
                    updateAiPlayersPosition(now);
                }
                }
            }

            // ゴール＆タッチライン判定（Hostまたはオフライン時）
            if (!isGuestClient) {
                checkGoalAndBounds();
            }

            // オンライン対戦同期データの送信
            if (isOnlineMatch) {
                pushOnlineStateIfNeeded(now);
            }

            // TV中継サイドビューカメラの滑らか追従（Hostは+X側、Guestは-X側から見て自チームが常に左→右へ攻める）
            if (camera && ball) {
                if (isGuestClient) {
                    const targetCamX = -88 + ball.position.x * 0.35;
                    const targetCamZ = Math.max(-62, Math.min(62, ball.position.z * 0.72));
                    camera.position.x += (targetCamX - camera.position.x) * 0.08;
                    camera.position.z += (targetCamZ - camera.position.z) * 0.08;
                    camera.lookAt(ball.position.x * 0.25, 0, ball.position.z * 0.85);
                } else {
                    const targetCamX = 88 + ball.position.x * 0.35;
                    const targetCamZ = Math.max(-62, Math.min(62, ball.position.z * 0.72));
                    camera.position.x += (targetCamX - camera.position.x) * 0.08;
                    camera.position.z += (targetCamZ - camera.position.z) * 0.08;
                    camera.lookAt(ball.position.x * 0.25, 0, ball.position.z * 0.85);
                }
            }

            // HUD・ミニマップ・操作選手頭上ネームタグ更新
            updateHUDAndRadar();

            if (renderer && scene && camera) {
                renderer.render(scene, camera);
            }
        }

        // =========================================================================
        // 7. ACTION BUTTONS, CURSOR SWITCHING, MATCH-UP & SET-PIECE EVENTS
        // =========================================================================
        function handleBtnDown(e, btnType) {
            if (e && e.cancelable) e.preventDefault();
            if (e && e.type && e.type.startsWith('touch')) {
                lastTouchBtnTime = Date.now();
            } else if (Date.now() - lastTouchBtnTime < 400) {
                return;
            }

            setActionBtnPressed(btnType, true);
            btnPressedWithBall[btnType] = hasBallPossession;

            if (hasBallPossession && !isBallInFlight) {
                startCharge();
            } else if (!hasBallPossession) {
                if (btnType === 'btmRight') {
                    switchCursorToNearest();
                } else if (btnType === 'topRight') {
                    isMatchUpHeld = true;
                    tryMatchUpSteal();
                } else if (btnType === 'topLeft') {
                    isPressHeld = true;
                }
            }
        }

        function handleBtnUp(e, btnType) {
            if (e && e.cancelable) e.preventDefault();
            if (e && e.type && e.type.startsWith('touch')) {
                lastTouchBtnTime = Date.now();
            } else if (Date.now() - lastTouchBtnTime < 400) {
                return;
            }

            setActionBtnPressed(btnType, false);
            const startedWithBall = btnPressedWithBall[btnType];
            btnPressedWithBall[btnType] = false;

            if (btnType === 'topRight') isMatchUpHeld = false;
            if (btnType === 'topLeft') isPressHeld = false;

            // 守備ボタン押下中にボールを奪取して指を離した時は、誤パス・誤シュートを防ぐ
            if (!startedWithBall) {
                stopCharge();
                if (btnType === 'topRight' && !hasBallPossession) {
                    tryMatchUpSteal();
                }
                return;
            }

            executeAction(btnType);
        }

        function handleBtnCancel(btnType) {
            setActionBtnPressed(btnType, false);
            btnPressedWithBall[btnType] = false;
            if (btnType === 'topRight') isMatchUpHeld = false;
            if (btnType === 'topLeft') isPressHeld = false;
            stopCharge();
        }

        function setActionBtnPressed(btnType, isPressed) {
            const idMap = {
                topRight: 'btnTopRight',
                topLeft: 'btnTopLeft',
                btmRight: 'btnBtmRight',
                btmLeft: 'btnBtmLeft'
            };
            const el = document.getElementById(idMap[btnType]);
            if (!el) return;
            if (isPressed) {
                el.classList.add('btn-pressed');
            } else {
                el.classList.remove('btn-pressed');
            }
        }
        function setDashState(pressed, e) {
            if (e && e.cancelable) e.preventDefault();
            isDashPressed = pressed;
            setActionBtnPressed('btmLeft', pressed);
        }

        function startCharge() {
            if (!hasBallPossession || isBallInFlight) return;
            stopCharge();
            kickPower = 0;
            const gauge = document.getElementById('powerGaugeContainer');
            const fill = document.getElementById('powerGaugeFill');
            if (gauge) gauge.classList.remove('hidden');
            if (fill) fill.style.width = '0%';

            chargeInterval = setInterval(() => {
                if (!hasBallPossession || isBallInFlight) {
                    stopCharge();
                    return;
                }
                kickPower = Math.min(100, kickPower + 6);
                if (fill) fill.style.width = kickPower + '%';
            }, 20);
        }

        function stopCharge() {
            if (chargeInterval) {
                clearInterval(chargeInterval);
                chargeInterval = null;
            }
            const gauge = document.getElementById('powerGaugeContainer');
            const fill = document.getElementById('powerGaugeFill');
            if (gauge) gauge.classList.add('hidden');
            if (fill) fill.style.width = '0%';
        }

        function executeAction(btnType) {
            const powerRatio = Math.max(0.25, kickPower / 100);
            stopCharge();

            const isGuestClient = isOnlineMatch && onlineRole === 'guest';

            // GKセーブ後のパス先選択中の場合は、選択中の味方へ配球実行
            if (isGkHoldingBall && !isGuestClient) {
                executeGkDistribution(btnType, powerRatio);
                return;
            }

            // オフサイド後のフリーキック蹴り先選択中の場合は、選択中の味方・方向へキック実行
            if (isFreeKickHolding && !isGuestClient) {
                executeFreeKickDistribution(btnType, powerRatio);
                return;
            }

            if (!hasBallPossession) {
                if (btnType === 'topRight') {
                    if (isGuestClient) {
                        pushOnlineStateIfNeeded(Date.now(), {
                            actionId: Date.now(),
                            actionType: 'matchup_steal',
                            powerRatio: 0,
                            aimX: 0,
                            aimZ: 1
                        });
                    } else {
                        tryMatchUpSteal();
                    }
                }
                return;
            }

            if (isBallInFlight || isKickoffWait || isGoalPause || isGkSaving || isOffsideFlagged) return;

            if (isKickoff) {
                isKickoff = false;
                const kb = document.getElementById('kickoffBanner');
                if (kb) kb.classList.add('opacity-0');
            }

            const myTeamArr = isGuestClient ? blueTeamPlayers : redTeamPlayers;
            const activePlayer = myTeamArr[controlledPlayerIndex];
            if (!activePlayer) return;

            // スティック方向（未入力時は相手ゴール方向）
            let aimX = isGuestClient ? -inputVector.z : inputVector.z;
            let aimZ = isGuestClient ? inputVector.x : -inputVector.x;
            const aimMag = Math.hypot(aimX, aimZ);
            if (aimMag > 0.1) {
                aimX /= aimMag;
                aimZ /= aimMag;
            } else {
                aimX = 0;
                aimZ = isGuestClient ? 1 : -1;
            }

            // ゲストクライアントの場合はアクションイベントをホストへ即時送信
            if (isGuestClient) {
                if (btnType === 'topLeft') {
                    const sb = document.getElementById('shootBanner');
                    if (sb) {
                        sb.classList.remove('hidden');
                        setTimeout(() => sb.classList.add('hidden'), 900);
                    }
                }
                pushOnlineStateIfNeeded(Date.now(), {
                    actionId: Date.now(),
                    actionType: btnType,
                    powerRatio,
                    aimX,
                    aimZ
                });
                return;
            }

            // パス/スルーパス時のオフサイドライン判定（相手2番目に深い守備者のZ座標）
            let offsideLineZ = -95;
            if (btnType === 'btmRight' || btnType === 'topRight') {
                const blueSortedZ = blueTeamPlayers.map(p => p.position.z).sort((a, b) => a - b);
                const secondDeepestZ = blueSortedZ[1] !== undefined ? blueSortedZ[1] : -95;
                offsideLineZ = Math.min(0, ball.position.z, secondDeepestZ);

                offsidePlayerIndices = [];
                redTeamPlayers.forEach((mate, idx) => {
                    if (idx === 0 || idx === controlledPlayerIndex) return;
                    if (mate.position.z < offsideLineZ - 0.5) {
                        offsidePlayerIndices.push(idx);
                    }
                });
            } else {
                offsidePlayerIndices = [];
            }

            if (btnType === 'btmRight' || btnType === 'topRight') {
                const isThrough = (btnType === 'topRight');
                const slotTemplate = formationTemplates[currentFormation] || formationTemplates['433'];
                const currentSlotPos = (slotTemplate[controlledPlayerIndex] || {}).pos;
                const passerStats = getEffectivePlayerStats(myTeamSquad[controlledPlayerIndex], currentSlotPos);
                const passPlan = computeVerticalBreakthroughPass(activePlayer, aimX, aimZ, isThrough, offsideLineZ);

                passTargetTeam = passPlan.targetIdx !== -1 ? 'red' : null;
                passTargetPlayerIndex = passPlan.targetIdx;
                passTargetSpot = { x: passPlan.spotX, z: passPlan.spotZ };
                isThroughPassInFlight = isThrough;

                const speed = (isThrough
                    ? (1.22 + powerRatio * 0.75)
                    : (1.04 + powerRatio * 0.65)) * passerStats.kickMult;
                const passErr = passerStats.isCompat ? 0 : (Math.random() - 0.5) * 0.24;
                ballVel = {
                    x: (passPlan.dirX + passErr) * speed,
                    z: passPlan.dirZ * speed,
                    y: isThrough ? 0.03 : 0.04
                };
                hasBallPossession = false;
                isBallInFlight = true;
                lastPasserTeam = 'red';
                lastPasserIndex = controlledPlayerIndex;
                lastPassTime = Date.now();
                playerDribbleTouchCount = 0;
                playerDribbleFrameCounter = 0;
            } else if (btnType === 'topLeft') {
                // SHOOT: 相手ゴール(-100)へのシュート
                const sb = document.getElementById('shootBanner');
                if (sb) {
                    sb.classList.remove('hidden');
                    setTimeout(() => sb.classList.add('hidden'), 900);
                }

                const slotTemplate = formationTemplates[currentFormation] || formationTemplates['433'];
                const currentSlotPos = (slotTemplate[controlledPlayerIndex] || {}).pos;
                const shooterStats = getEffectivePlayerStats(myTeamSquad[controlledPlayerIndex], currentSlotPos);
                const shotSpread = shooterStats.isCompat ? 0 : (Math.random() - 0.5) * 14.0;

                const targetGoalX = Math.max(-6.8, Math.min(6.8, inputVector.z * 7.2)) + shotSpread;
                const targetGoalZ = -100;
                const dx = targetGoalX - ball.position.x;
                const dz = targetGoalZ - ball.position.z;
                const dist = Math.hypot(dx, dz) || 1;

                const shotSpeed = (1.65 + powerRatio * 0.95) * shooterStats.kickMult;
                ballVel = {
                    x: (dx / dist) * shotSpeed,
                    z: (dz / dist) * shotSpeed,
                    y: 0.14 + powerRatio * 0.24 + (shooterStats.isCompat ? 0 : 0.14)
                };
                hasBallPossession = false;
                isBallInFlight = true;
                passTargetTeam = null;
                passTargetPlayerIndex = -1;
                isThroughPassInFlight = false;
                lastPasserTeam = 'red';
                lastPasserIndex = controlledPlayerIndex;
                lastPassTime = Date.now();
                playerDribbleTouchCount = 0;
                playerDribbleFrameCounter = 0;
            }
        }

        function computeVerticalBreakthroughPass(activePlayer, aimX, aimZ, isThrough, offsideLineZ) {
            const sMag = Math.hypot(aimX, aimZ) || 1;
            const normSearchX = aimX / sMag;
            const normSearchZ = aimZ / sMag;
            const isForwardAim = normSearchZ < -0.25;

            let bestTarget = null;
            let bestTargetIdx = -1;
            let bestScore = -999;
            let bestNearestDef = null;

            redTeamPlayers.forEach((mate, idx) => {
                if (idx === controlledPlayerIndex) return;
                if (normSearchZ <= 0.25 && idx === 0) return;

                const dx = mate.position.x - activePlayer.position.x;
                const dz = mate.position.z - activePlayer.position.z;
                const dist = Math.hypot(dx, dz);
                const maxRange = isThrough ? 105 : 92;
                if (dist < 4 || dist > maxRange) return;

                // スティックを倒した方向に近い選手のみを候補にする（上下左右へのパスを優先）
                const dot = (dx / dist) * normSearchX + (dz / dist) * normSearchZ;
                if (dot < 0.45) return;

                // 1. 受け手周囲のマーキング状況判定（最寄り相手DFとの距離）
                let nearestDefDist = 999;
                let nearestDefObj = null;
                for (let b = 1; b < blueTeamPlayers.length; b++) {
                    const def = blueTeamPlayers[b];
                    const dDef = Math.hypot(def.position.x - mate.position.x, def.position.z - mate.position.z);
                    if (dDef < nearestDefDist) {
                        nearestDefDist = dDef;
                        nearestDefObj = def;
                    }
                }

                let markingScore = 0;
                if (nearestDefDist < 4.5) {
                    markingScore = -42; // 密着マークされている選手は減点
                } else if (nearestDefDist < 7.8) {
                    markingScore = -18;
                } else if (nearestDefDist < 11.0) {
                    markingScore = 10;
                } else {
                    markingScore = 26;  // フリーの選手に加点
                }

                // 2. パスコース（ボール〜受け手間の線分）のインターセプト危険度判定
                let laneBlockPenalty = 0;
                const segX = mate.position.x - ball.position.x;
                const segZ = mate.position.z - ball.position.z;
                const segLenSq = segX * segX + segZ * segZ || 1;
                for (let b = 1; b < blueTeamPlayers.length; b++) {
                    const def = blueTeamPlayers[b];
                    const t = ((def.position.x - ball.position.x) * segX + (def.position.z - ball.position.z) * segZ) / segLenSq;
                    if (t > 0.12 && t < 0.94) {
                        const projX = ball.position.x + segX * t;
                        const projZ = ball.position.z + segZ * t;
                        const perpDist = Math.hypot(def.position.x - projX, def.position.z - projZ);
                        if (perpDist < 2.2) {
                            laneBlockPenalty = Math.max(laneBlockPenalty, 30);
                        } else if (perpDist < 3.8) {
                            laneBlockPenalty = Math.max(laneBlockPenalty, 12);
                        }
                    }
                }

                // 3. スティックを前方向に倒している時のみ控えめな縦方向ボーナス
                let forwardBonus = 0;
                if (isForwardAim && dz < 0) {
                    forwardBonus = Math.min(10, (-dz) * 0.22);
                }

                const score = dot * 88 + forwardBonus + markingScore - laneBlockPenalty - dist * 0.25;
                if (score > bestScore) {
                    bestScore = score;
                    bestTarget = mate;
                    bestTargetIdx = idx;
                    bestNearestDef = nearestDefObj;
                }
            });

            let spotX = ball.position.x + normSearchX * (isThrough ? 28 : 22);
            let spotZ = ball.position.z + normSearchZ * (isThrough ? 28 : 22);

            if (bestTarget) {
                // スティック入力方向への自然なリードに抑え、強制的な縦曲げを弱める
                const directionalLead = isThrough ? 7.5 : 2.2;
                const forwardLead = isForwardAim ? (isThrough ? 5.5 : 2.0) : 0;

                let leadX = bestTarget.position.x + normSearchX * directionalLead;
                let leadZ = bestTarget.position.z + normSearchZ * directionalLead - forwardLead;

                // 受け手付近にDFがいる場合は、DFから少し離れる側へ微調整
                if (bestNearestDef) {
                    const dToDef = Math.hypot(bestNearestDef.position.x - bestTarget.position.x, bestNearestDef.position.z - bestTarget.position.z);
                    if (dToDef < 9.0) {
                        leadX += (bestTarget.position.x >= bestNearestDef.position.x ? 1 : -1) * 1.4;
                    }
                }

                // 通常パス時はオンサイド位置の受け手がオフサイドにならないよう安全クランプ
                if (!isThrough && bestTarget.position.z >= offsideLineZ - 0.2) {
                    leadZ = Math.max(offsideLineZ + 0.4, leadZ);
                }

                spotX = leadX;
                spotZ = leadZ;
            }

            spotX = Math.max(-55, Math.min(55, spotX));
            spotZ = Math.max(-96, Math.min(96, spotZ));

            const dx = spotX - ball.position.x;
            const dz = spotZ - ball.position.z;
            const d = Math.hypot(dx, dz) || 1;

            return {
                targetIdx: bestTargetIdx,
                spotX,
                spotZ,
                dirX: dx / d,
                dirZ: dz / d
            };
        }

        function switchCursorToNearest() {
            const now = Date.now();
            if (now - lastCursorSwitchTime < 140) return;

            const isGuestClient = isOnlineMatch && onlineRole === 'guest';
            const myTeamArr = isGuestClient ? blueTeamPlayers : redTeamPlayers;

            // 現在操作中以外の味方フィールド選手をボールに近い順に並べ、上位3人を検知
            const candidates = [];
            for (let i = 1; i < myTeamArr.length; i++) {
                if (i === controlledPlayerIndex) continue;
                const p = myTeamArr[i];
                if (!p) continue;
                const dist = Math.hypot(p.position.x - ball.position.x, p.position.z - ball.position.z);
                candidates.push({ idx: i, player: p, dist });
            }
            candidates.sort((a, b) => a.dist - b.dist);
            const topThree = candidates.slice(0, 3);
            if (topThree.length === 0) return;

            // スティック入力がある場合は、ボールに近い3人の中から最もカーソルの向きに合った選手を選択
            const stickX = isGuestClient ? -inputVector.z : inputVector.z;
            const stickZ = isGuestClient ? inputVector.x : -inputVector.x;
            const stickMag = Math.hypot(stickX, stickZ);

            if (stickMag > 0.15) {
                const sDirX = stickX / stickMag;
                const sDirZ = stickZ / stickMag;
                const refPos = myTeamArr[controlledPlayerIndex]
                    ? myTeamArr[controlledPlayerIndex].position
                    : ball.position;

                let bestIdx = topThree[0].idx;
                let bestAlign = -999;

                topThree.forEach(c => {
                    const vx = c.player.position.x - refPos.x;
                    const vz = c.player.position.z - refPos.z;
                    const vLen = Math.hypot(vx, vz) || 1;
                    const align = (vx / vLen) * sDirX + (vz / vLen) * sDirZ;
                    if (align > bestAlign) {
                        bestAlign = align;
                        bestIdx = c.idx;
                    }
                });

                controlledPlayerIndex = bestIdx;
            } else {
                // スティックを倒していない時はボールから一番近い選手に交代
                controlledPlayerIndex = topThree[0].idx;
            }

            lastCursorSwitchTime = now;
        }

        function tryMatchUpSteal() {
            if (hasBallPossession || isBallInFlight || isKickoffWait || isGoalPause || isGkSaving || isOffsideFlagged) return;
            const activePlayer = redTeamPlayers[controlledPlayerIndex];
            if (!activePlayer || !ball) return;

            const now = Date.now();
            if (now < playerTackleCooldowns[controlledPlayerIndex]) return;

            const distToBall = activePlayer.position.distanceTo(ball.position);
            let closeToCarrier = false;
            blueTeamPlayers.forEach((cpu, idx) => {
                if (idx !== 0 && activePlayer.position.distanceTo(cpu.position) < 2.25) {
                    closeToCarrier = true;
                }
            });

            // ボールに十分近づいている時のみ奪取を許可し、ball.positionの強制上書き（瞬間移動）を廃止
            if (distToBall < 2.45 || (closeToCarrier && distToBall < 2.75)) {
                hasBallPossession = true;
                lastPossessionChangeTime = now;
                for (let k = 0; k < 11; k++) {
                    cpuTackleCooldowns[k] = now + 500;
                }
                playerDribbleTouchCount = 0;
                playerDribbleFrameCounter = 0;
            }
        }

        function triggerNiceSave(gkMesh, isBlueGk) {
            if (isGkSaving || isGkHoldingBall) return;
            isGkSaving = true;
            isBallInFlight = false;
            passTargetTeam = null;
            passTargetPlayerIndex = -1;
            isThroughPassInFlight = false;
            ballVel = { x: 0, z: 0, y: 0 };
            currentGkMesh = gkMesh;

            // シュートバナーが残っている場合は即座に閉じてNICE SAVE!を明確に表示
            const shootB = document.getElementById('shootBanner');
            if (shootB) shootB.classList.add('hidden');

            // GKのセービング飛びつき演出
            const diveOffset = Math.max(-1.2, Math.min(1.2, ball.position.x - gkMesh.position.x));
            gkMesh.position.x = Math.max(-6.8, Math.min(6.8, gkMesh.position.x + diveOffset * 0.55));
            gkMesh.rotation.z = diveOffset >= 0 ? -0.42 : 0.42;

            ball.position.set(gkMesh.position.x, 1.4, gkMesh.position.z + (isBlueGk ? 1.1 : -1.1));

            const sb = document.getElementById('saveBanner');
            if (sb) sb.classList.remove('hidden');

            // セーブ演出後、相手GKは自動配球、味方GKはパス先選択モードへ移行
            setTimeout(() => {
                if (sb) sb.classList.add('hidden');
                if (gkMesh) gkMesh.rotation.z = 0;
                isGkSaving = false;
                if (!isMatchRunning) return;

                if (isBlueGk) {
                    const candidateIndices = [1, 2, 3, 4, 5, 6, 7];
                    const targetIdx = candidateIndices[Math.floor(Math.random() * candidateIndices.length)];
                    const targetMate = blueTeamPlayers[targetIdx] || blueTeamPlayers[2];
                    const tx = targetMate ? targetMate.position.x : (Math.random() * 40 - 20);
                    const tz = targetMate ? targetMate.position.z : -62;
                    const dx = tx - ball.position.x;
                    const dz = tz - ball.position.z;
                    const d = Math.hypot(dx, dz) || 1;

                    ball.position.y = 0.75;
                    ballVel = { x: (dx / d) * 1.15, z: (dz / d) * 1.15, y: 0.05 };
                    isBallInFlight = true;
                    hasBallPossession = false;
                    passTargetTeam = 'blue';
                    passTargetPlayerIndex = targetMate ? targetIdx : -1;
                    passTargetSpot = { x: tx, z: tz };
                    isThroughPassInFlight = false;
                    lastPasserTeam = 'blue';
                    lastPasserIndex = 0;
                    lastPassTime = Date.now();
                } else {
                    // プレイヤー側GK：パス先選択モード開始
                    isGkHoldingBall = true;
                    gkHoldStartTime = Date.now();
                    controlledPlayerIndex = 0;
                    hasBallPossession = true;
                    isBallInFlight = false;

                    // 初期ターゲットは最もパスを通しやすいDF/MFを選択
                    gkTargetPlayerIdx = 1;
                    let bestInitScore = -999;
                    for (let i = 1; i < redTeamPlayers.length; i++) {
                        const m = redTeamPlayers[i];
                        if (!m) continue;
                        const dist = Math.hypot(m.position.x - gkMesh.position.x, m.position.z - gkMesh.position.z);
                        if (dist > 10 && dist < 55) {
                            let nearestDef = 999;
                            for (let b = 1; b < blueTeamPlayers.length; b++) {
                                const dDef = Math.hypot(blueTeamPlayers[b].position.x - m.position.x, blueTeamPlayers[b].position.z - m.position.z);
                                if (dDef < nearestDef) nearestDef = dDef;
                            }
                            const freeBonus = nearestDef >= 10 ? 35 : (nearestDef < 5 ? -40 : 0);
                            const score = 60 - Math.abs(dist - 28) + freeBonus;
                            if (score > bestInitScore) {
                                bestInitScore = score;
                                gkTargetPlayerIdx = i;
                            }
                        }
                    }

                    const gkBanner = document.getElementById('gkPassBanner');
                    if (gkBanner) gkBanner.classList.remove('hidden');
                    updateGkTargetVisuals();
                }
            }, 1150);
        }

        function updateGkTargetVisuals() {
            const targetMesh = redTeamPlayers[gkTargetPlayerIdx];
            const targetData = myTeamSquad[gkTargetPlayerIdx] || { pos: 'DF', name: '味方選手' };
            const labelEl = document.getElementById('gkTargetPlayerLabel');
            if (labelEl) {
                labelEl.innerText = `[${targetData.pos}] ${getDisplayPlayerName(targetData.name)}`;
            }
            if (gkTargetRing && targetMesh) {
                gkTargetRing.visible = true;
                gkTargetRing.position.x = targetMesh.position.x;
                gkTargetRing.position.z = targetMesh.position.z;
                const scalePulse = 1.0 + ((Date.now() % 600) / 600) * 0.25;
                gkTargetRing.scale.set(scalePulse, scalePulse, 1);
            }
        }

        function updateGkDistributionMode(now, worldMoveX, worldMoveZ, inputMag) {
            const gk = redTeamPlayers[0];
            if (!gk || !ball) return;

            // スティック入力方向に応じてパス先候補（1〜10番の味方選手）をリアルタイム選択
            if (inputMag > 0.15) {
                const dirX = worldMoveX / inputMag;
                const dirZ = worldMoveZ / inputMag;
                let bestIdx = gkTargetPlayerIdx;
                let bestScore = -999;

                for (let i = 1; i < redTeamPlayers.length; i++) {
                    const mate = redTeamPlayers[i];
                    if (!mate) continue;
                    const dx = mate.position.x - gk.position.x;
                    const dz = mate.position.z - gk.position.z;
                    const dist = Math.hypot(dx, dz);
                    if (dist < 6) continue;
                    const dot = (dx / dist) * dirX + (dz / dist) * dirZ;
                    if (dot > 0.25) {
                        const score = dot * 100 - dist * 0.22;
                        if (score > bestScore) {
                            bestScore = score;
                            bestIdx = i;
                        }
                    }
                }
                gkTargetPlayerIdx = bestIdx;

                // ペナルティエリア内でGKも少し位置調整可能
                gk.position.x = Math.max(-16, Math.min(16, gk.position.x + dirX * 0.12));
                gk.position.z = Math.max(82, Math.min(97, gk.position.z + dirZ * 0.12));
            }

            // GKの体をターゲット選手の方へ向ける
            const targetMesh = redTeamPlayers[gkTargetPlayerIdx];
            if (targetMesh) {
                gk.rotation.y = Math.atan2(targetMesh.position.x - gk.position.x, targetMesh.position.z - gk.position.z);
            }

            ball.position.set(
                gk.position.x + Math.sin(gk.rotation.y) * 0.95,
                1.35,
                gk.position.z + Math.cos(gk.rotation.y) * 0.95
            );
            updateGkTargetVisuals();

            // 8秒経過時は現在のターゲットへ自動パス（進行停止防止）
            if (now - gkHoldStartTime > 8000) {
                executeGkDistribution('btmRight', 0.45);
            }
        }

        function executeGkDistribution(btnType, powerRatio) {
            const gk = redTeamPlayers[0];
            const targetMate = redTeamPlayers[gkTargetPlayerIdx] || redTeamPlayers[2];
            isGkHoldingBall = false;

            const gkBanner = document.getElementById('gkPassBanner');
            if (gkBanner) gkBanner.classList.add('hidden');
            if (gkTargetRing) gkTargetRing.visible = false;

            if (!gk || !targetMate || !ball) return;

            let aimSpotX = targetMate.position.x;
            let aimSpotZ = targetMate.position.z;
            let speed = 1.15 + powerRatio * 0.55;
            let loftY = 0.05;
            let isThrough = false;

            if (btnType === 'topRight') {
                // THROUGH: 選択した選手の前方スペースへスルーパス
                aimSpotZ = Math.max(-85, targetMate.position.z - 12);
                speed = 1.25 + powerRatio * 0.65;
                loftY = 0.14;
                isThrough = true;
            } else if (btnType === 'topLeft') {
                // PUNT: 選択した選手の方向へ大きく蹴り出すパントキック
                aimSpotZ = Math.max(-65, targetMate.position.z - 22);
                speed = 1.48 + powerRatio * 0.72;
                loftY = 0.34 + powerRatio * 0.14;
                isThrough = true;
            }

            const dx = aimSpotX - gk.position.x;
            const dz = aimSpotZ - gk.position.z;
            const d = Math.hypot(dx, dz) || 1;

            ball.position.set(gk.position.x + (dx / d) * 1.1, 0.85, gk.position.z + (dz / d) * 1.1);
            ballVel = {
                x: (dx / d) * speed,
                z: (dz / d) * speed,
                y: loftY
            };

            hasBallPossession = false;
            isBallInFlight = true;
            passTargetTeam = 'red';
            passTargetPlayerIndex = gkTargetPlayerIdx;
            passTargetSpot = { x: aimSpotX, z: aimSpotZ };
            isThroughPassInFlight = isThrough;
            lastPasserTeam = 'red';
            lastPasserIndex = 0;
            lastPassTime = Date.now();
            offsidePlayerIndices = [];
        }

        function triggerOffside(isRedOffside) {
            if (isOffsideFlagged) return;
            isOffsideFlagged = true;
            isBallInFlight = false;
            passTargetTeam = null;
            passTargetPlayerIndex = -1;
            isThroughPassInFlight = false;
            ballVel = { x: 0, z: 0, y: 0 };

            const ob = document.getElementById('offsideBanner');
            if (ob) ob.classList.remove('hidden');

            if (offsideTimeout) clearTimeout(offsideTimeout);
            offsideTimeout = setTimeout(() => {
                if (ob) ob.classList.add('hidden');
                isOffsideFlagged = false;
                offsidePlayerIndices = [];
                cpuOffsidePlayerIndices = [];
                if (!isMatchRunning) return;

                const fkX = Math.max(-52, Math.min(52, ball.position.x));
                const fkZ = Math.max(-90, Math.min(90, ball.position.z));
                ball.position.set(fkX, 0.75, fkZ);

                if (isRedOffside) {
                    // Red側オフサイド：相手CPUがフリーキックを蹴って再開
                    hasBallPossession = false;
                    const restartCpu = blueTeamPlayers[2] || blueTeamPlayers[1];
                    if (restartCpu) {
                        restartCpu.position.set(fkX, 0, Math.max(-92, fkZ - 0.8));
                    }
                } else {
                    // Blue側オフサイド：プレイヤー側（Red）が蹴る場所を選べるフリーキックモード開始
                    startRedFreeKickMode(fkX, fkZ);
                }
            }, 1400);
        }

        function startRedFreeKickMode(fkX, fkZ) {
            // キッカーをDF/MFから選択し、ボールのすぐ後ろに配置
            fkKickerIdx = 2;
            const kicker = redTeamPlayers[fkKickerIdx] || redTeamPlayers[1];
            if (kicker) {
                kicker.position.set(fkX, 0, Math.min(95, fkZ + 1.1));
                kicker.rotation.y = Math.PI;
            }

            // 他の味方・相手選手はフリーキック地点から最低12m離れてセットピース陣形に整列
            const template = formationTemplates[currentFormation] || formationTemplates['433'];
            redTeamPlayers.forEach((p, idx) => {
                if (idx === 0 || idx === fkKickerIdx) return;
                const slot = template[idx] || { x: 50, y: 50 };
                let tx = (slot.x - 50) * 1.12;
                let tz = Math.max(-88, Math.min(86, fkZ + (slot.y - 55) * 1.35));
                if (Math.hypot(tx - fkX, tz - fkZ) < 13) {
                    tz = Math.max(-88, fkZ - 15);
                    tx = Math.max(-52, Math.min(52, tx + (tx >= fkX ? 10 : -10)));
                }
                p.position.set(tx, 0, tz);
            });

            blueTeamPlayers.forEach((cpu, idx) => {
                if (idx === 0) return;
                const d = Math.hypot(cpu.position.x - fkX, cpu.position.z - fkZ);
                if (d < 14) {
                    const pushDirX = d > 0.1 ? (cpu.position.x - fkX) / d : 0;
                    const pushDirZ = d > 0.1 ? (cpu.position.z - fkZ) / d : -1;
                    cpu.position.x = Math.max(-54, Math.min(54, fkX + pushDirX * 14.5));
                    cpu.position.z = Math.max(-92, Math.min(85, fkZ + pushDirZ * 14.5));
                }
            });

            controlledPlayerIndex = fkKickerIdx;
            hasBallPossession = true;
            isBallInFlight = false;
            isFreeKickHolding = true;
            fkHoldStartTime = Date.now();

            // 初期ターゲットは最もフリーでパスを通しやすい味方選手を選択
            fkTargetPlayerIdx = 5;
            let bestInitScore = -999;
            for (let i = 1; i < redTeamPlayers.length; i++) {
                if (i === fkKickerIdx) continue;
                const m = redTeamPlayers[i];
                if (!m) continue;
                const dist = Math.hypot(m.position.x - fkX, m.position.z - fkZ);
                if (dist < 8 || dist > 75) continue;

                let nearestDef = 999;
                for (let b = 1; b < blueTeamPlayers.length; b++) {
                    const dDef = Math.hypot(blueTeamPlayers[b].position.x - m.position.x, blueTeamPlayers[b].position.z - m.position.z);
                    if (dDef < nearestDef) nearestDef = dDef;
                }
                const freeBonus = nearestDef >= 10 ? 40 : (nearestDef < 5 ? -45 : 0);
                const forwardBonus = Math.max(0, fkZ - m.position.z) * 0.45;
                const score = 50 - Math.abs(dist - 26) * 0.5 + freeBonus + forwardBonus;
                if (score > bestInitScore) {
                    bestInitScore = score;
                    fkTargetPlayerIdx = i;
                }
            }

            const initTarget = redTeamPlayers[fkTargetPlayerIdx] || redTeamPlayers[5];
            fkAimSpot = initTarget
                ? { x: initTarget.position.x, z: initTarget.position.z }
                : { x: fkX, z: Math.max(-88, fkZ - 24) };
            const initDx = fkAimSpot.x - fkX;
            const initDz = fkAimSpot.z - fkZ;
            const initLen = Math.hypot(initDx, initDz) || 1;
            fkAimDir = { x: initDx / initLen, z: initDz / initLen };
            fkAimDist = Math.max(12, Math.min(48, initLen));

            const fkBanner = document.getElementById('freeKickBanner');
            if (fkBanner) fkBanner.classList.remove('hidden');
            updateFreeKickTargetVisuals();
        }

        function updateFreeKickTargetVisuals() {
            const kicker = redTeamPlayers[fkKickerIdx];
            const targetMesh = fkTargetPlayerIdx !== -1 ? redTeamPlayers[fkTargetPlayerIdx] : null;
            const targetData = fkTargetPlayerIdx !== -1 ? (myTeamSquad[fkTargetPlayerIdx] || { pos: 'MF', name: '味方選手' }) : null;
            const labelEl = document.getElementById('fkTargetPlayerLabel');

            if (targetMesh && targetData) {
                fkAimSpot.x = targetMesh.position.x;
                fkAimSpot.z = targetMesh.position.z;
                if (labelEl) {
                    labelEl.innerText = `[${targetData.pos}] ${getDisplayPlayerName(targetData.name)}`;
                }
            } else if (labelEl) {
                labelEl.innerText = currentLang === 'en' ? 'OPEN SPACE (FREE AIM)' : 'オープンスペース (自由照準)';
            }

            if (gkTargetRing) {
                gkTargetRing.visible = true;
                gkTargetRing.position.x = fkAimSpot.x;
                gkTargetRing.position.z = fkAimSpot.z;
                const scalePulse = 1.0 + ((Date.now() % 600) / 600) * 0.25;
                gkTargetRing.scale.set(scalePulse, scalePulse, 1);
            }

            if (fkAimLine && kicker && ball) {
                const dx = fkAimSpot.x - ball.position.x;
                const dz = fkAimSpot.z - ball.position.z;
                const dist = Math.hypot(dx, dz);
                if (dist > 1) {
                    fkAimLine.visible = true;
                    fkAimLine.position.x = (ball.position.x + fkAimSpot.x) * 0.5;
                    fkAimLine.position.z = (ball.position.z + fkAimSpot.z) * 0.5;
                    fkAimLine.scale.set(1, dist, 1);
                    fkAimLine.rotation.y = Math.atan2(dx, dz);
                } else {
                    fkAimLine.visible = false;
                }
            }
        }

        function updateFreeKickDistributionMode(now, worldMoveX, worldMoveZ, inputMag) {
            const kicker = redTeamPlayers[fkKickerIdx];
            if (!kicker || !ball) return;

            // スティック入力方向に応じて味方選手へのロックオン、または任意のオープンスペース照準を切り替え
            if (inputMag > 0.15) {
                const dirX = worldMoveX / inputMag;
                const dirZ = worldMoveZ / inputMag;
                fkAimDir = { x: dirX, z: dirZ };
                fkAimDist = 18 + Math.min(1, inputMag) * 28;

                let bestIdx = -1;
                let bestScore = -999;

                for (let i = 1; i < redTeamPlayers.length; i++) {
                    if (i === fkKickerIdx) continue;
                    const mate = redTeamPlayers[i];
                    if (!mate) continue;
                    const dx = mate.position.x - ball.position.x;
                    const dz = mate.position.z - ball.position.z;
                    const dist = Math.hypot(dx, dz);
                    if (dist < 5 || dist > 78) continue;

                    const dot = (dx / dist) * dirX + (dz / dist) * dirZ;
                    // スティック方向に味方選手がいる場合はその選手へ自動ロックオン
                    if (dot > 0.72) {
                        let nearestDef = 999;
                        for (let b = 1; b < blueTeamPlayers.length; b++) {
                            const dDef = Math.hypot(blueTeamPlayers[b].position.x - mate.position.x, blueTeamPlayers[b].position.z - mate.position.z);
                            if (dDef < nearestDef) nearestDef = dDef;
                        }
                        const freeBonus = nearestDef >= 10 ? 14 : (nearestDef < 4.5 ? -14 : 0);
                        const score = dot * 100 + freeBonus - dist * 0.18;
                        if (score > bestScore) {
                            bestScore = score;
                            bestIdx = i;
                        }
                    }
                }

                fkTargetPlayerIdx = bestIdx;
                if (bestIdx === -1) {
                    // 味方選手がいない方向へ倒した場合は指定方向のオープンスペースへ照準を移動
                    fkAimSpot.x = Math.max(-55, Math.min(55, ball.position.x + dirX * fkAimDist));
                    fkAimSpot.z = Math.max(-94, Math.min(94, ball.position.z + dirZ * fkAimDist));
                }
            }

            // キッカーの体をターゲット方向へ向ける
            const targetMesh = fkTargetPlayerIdx !== -1 ? redTeamPlayers[fkTargetPlayerIdx] : null;
            const aimX = targetMesh ? targetMesh.position.x : fkAimSpot.x;
            const aimZ = targetMesh ? targetMesh.position.z : fkAimSpot.z;
            const angle = Math.atan2(aimX - ball.position.x, aimZ - ball.position.z);
            kicker.rotation.y = angle;
            kicker.position.x = ball.position.x - Math.sin(angle) * 1.1;
            kicker.position.z = ball.position.z - Math.cos(angle) * 1.1;

            updateFreeKickTargetVisuals();

            // 10秒経過時は現在のターゲットへ自動キック（進行停止防止）
            if (now - fkHoldStartTime > 10000) {
                executeFreeKickDistribution('btmRight', 0.45);
            }
        }

        function executeFreeKickDistribution(btnType, powerRatio) {
            const targetMate = fkTargetPlayerIdx !== -1 ? redTeamPlayers[fkTargetPlayerIdx] : null;
            isFreeKickHolding = false;

            const fkBanner = document.getElementById('freeKickBanner');
            if (fkBanner) fkBanner.classList.add('hidden');
            if (gkTargetRing) gkTargetRing.visible = false;
            if (fkAimLine) fkAimLine.visible = false;

            if (!ball) return;

            let aimSpotX = targetMate ? targetMate.position.x : fkAimSpot.x;
            let aimSpotZ = targetMate ? targetMate.position.z : fkAimSpot.z;
            let speed = 1.15 + powerRatio * 0.62;
            let loftY = 0.04;
            let isThrough = false;

            if (btnType === 'topRight') {
                // THROUGH: 選択した選手・方向の前方スペースへスルーパス
                aimSpotZ = Math.max(-92, aimSpotZ - 12.5);
                speed = 1.26 + powerRatio * 0.72;
                loftY = 0.08;
                isThrough = true;
            } else if (btnType === 'topLeft') {
                // LONG: 選択した選手・方向へ大きく浮き球のロングフィード
                aimSpotZ = Math.max(-94, aimSpotZ - 16);
                speed = 1.46 + powerRatio * 0.78;
                loftY = 0.30 + powerRatio * 0.16;
                isThrough = true;
            }

            const dx = aimSpotX - ball.position.x;
            const dz = aimSpotZ - ball.position.z;
            const d = Math.hypot(dx, dz) || 1;

            ball.position.y = 0.82;
            ballVel = {
                x: (dx / d) * speed,
                z: (dz / d) * speed,
                y: loftY
            };

            hasBallPossession = false;
            isBallInFlight = true;
            passTargetTeam = targetMate ? 'red' : null;
            passTargetPlayerIndex = targetMate ? fkTargetPlayerIdx : -1;
            passTargetSpot = { x: aimSpotX, z: aimSpotZ };
            isThroughPassInFlight = isThrough;
            lastPasserTeam = 'red';
            lastPasserIndex = fkKickerIdx;
            lastPassTime = Date.now();
            offsidePlayerIndices = [];
        }

        // =========================================================================
        // 8. AI POSITIONING, PROGRESSIVE DEFENSE & MATCH RULES
        // =========================================================================
        function updateAiPlayersPosition(now) {
            if (!ball) return;
            const template = formationTemplates[currentFormation] || formationTemplates['433'];
            const activePlayer = redTeamPlayers[controlledPlayerIndex];

            // フリーキック選択待機中は選手同士の重なりを防ぐため現在位置で待機
            if (isFreeKickHolding) return;

            // 1. 味方GK (redTeamPlayers[0]) & 相手GK (blueTeamPlayers[0]) のバランス調整済みセービング移動
            if (redTeamPlayers[0]) {
                const redGk = redTeamPlayers[0];
                const gkStats = getEffectivePlayerStats(myTeamSquad[0], 'GK');
                const gkReact = gkStats.isCompat ? 0.12 : 0.045;
                let targetGkX = Math.max(-6.8, Math.min(6.8, ball.position.x * 0.72));
                if (isBallInFlight && ballVel.z > 0.3 && ball.position.z > 45) {
                    const stepsToGoal = (96.5 - ball.position.z) / ballVel.z;
                    const predX = ball.position.x + ballVel.x * stepsToGoal;
                    targetGkX = Math.max(-6.8, Math.min(6.8, predX * (gkStats.isCompat ? 0.84 : 0.45)));
                }
                redGk.position.x += (targetGkX - redGk.position.x) * gkReact;
                redGk.position.z += (96.5 - redGk.position.z) * 0.1;
                redGk.rotation.y = Math.PI;
            }

            if (blueTeamPlayers[0]) {
                const blueGk = blueTeamPlayers[0];
                let targetGkX = Math.max(-6.8, Math.min(6.8, ball.position.x * 0.72));
                if (isBallInFlight && ballVel.z < -0.3 && ball.position.z < -45) {
                    const stepsToGoal = (-96.5 - ball.position.z) / ballVel.z;
                    const predX = ball.position.x + ballVel.x * stepsToGoal;
                    targetGkX = Math.max(-6.8, Math.min(6.8, predX * 0.84));
                }
                blueGk.position.x += (targetGkX - blueGk.position.x) * 0.12;
                blueGk.position.z += (-96.5 - blueGk.position.z) * 0.1;
                blueGk.rotation.y = 0;
            }

            // オフサイドライン算出（味方AIが不用意にオフサイドポジションに留まらないための基準）
            const blueSortedZ = blueTeamPlayers.map(p => p.position.z).sort((a, b) => a - b);
            const redAttackOffsideZ = Math.min(0, ball.position.z, blueSortedZ[1] !== undefined ? blueSortedZ[1] : -95);

            const redSortedZ = redTeamPlayers.map(p => p.position.z).sort((a, b) => b - a);
            const blueAttackOffsideZ = Math.max(0, ball.position.z, redSortedZ[1] !== undefined ? redSortedZ[1] : 95);

            // 自陣ゴールへの危険度 (0.0 ~ 1.0): ゴール前に近づくにつれてディフェンスがボールを奪いに行く
            const redGoalDanger = Math.max(0, Math.min(1, (ball.position.z + 10) / 95));
            const cpuGoalDanger = Math.max(0, Math.min(1, (10 - ball.position.z) / 95));

            // ボールに最も近い味方フィールド選手インデックス（PRESSボタン用）
            let nearestRedIdx = -1;
            let nearestRedDist = 999;
            for (let i = 1; i < redTeamPlayers.length; i++) {
                const d = redTeamPlayers[i].position.distanceTo(ball.position);
                if (d < nearestRedDist) {
                    nearestRedDist = d;
                    nearestRedIdx = i;
                }
            }

            // 2. 味方AIフィールド選手 (redTeamPlayers[1..10])
            const isRedAttacking = hasBallPossession || (isBallInFlight && lastPasserTeam === 'red');

            redTeamPlayers.forEach((p, idx) => {
                if (idx === 0 || idx === controlledPlayerIndex) return;

                const slot = template[idx] || { pos: 'MF', x: 50, y: 50 };
                const pStats = getEffectivePlayerStats(myTeamSquad[idx], slot.pos);
                const aiSpeed = 0.14 + (pStats.spd / 100) * 0.21;

                // パスを受け取るターゲット選手はボールの軌道・受け取り地点へ積極的に走り込む
                const isReceivingPass = isBallInFlight && passTargetTeam === 'red' && idx === passTargetPlayerIndex;
                if (isReceivingPass) {
                    const bSpeed = Math.hypot(ballVel.x, ballVel.z);
                    let recvX = ball.position.x;
                    let recvZ = ball.position.z;

                    if (bSpeed > 0.05) {
                        const dirX = ballVel.x / bSpeed;
                        const dirZ = ballVel.z / bSpeed;
                        const toPlayerX = p.position.x - ball.position.x;
                        const toPlayerZ = p.position.z - ball.position.z;
                        const proj = Math.max(0, Math.min(28, toPlayerX * dirX + toPlayerZ * dirZ));

                        if (isThroughPassInFlight) {
                            // スルーパス時は前方スペースの受け取り地点へスプリント
                            const aheadX = ball.position.x + ballVel.x * 12;
                            const aheadZ = ball.position.z + ballVel.z * 12;
                            recvX = passTargetSpot.x * 0.6 + aheadX * 0.4;
                            recvZ = passTargetSpot.z * 0.6 + aheadZ * 0.4;
                        } else {
                            // 縦突破アシストされた受け取り地点へ向かって走り込みながらミートする
                            const interceptX = ball.position.x + dirX * (proj * 0.65);
                            const interceptZ = ball.position.z + dirZ * (proj * 0.65);
                            recvX = passTargetSpot.x * 0.55 + interceptX * 0.45;
                            recvZ = passTargetSpot.z * 0.55 + interceptZ * 0.45;
                        }
                    }

                    recvX = Math.max(-57, Math.min(57, recvX));
                    recvZ = Math.max(-96, Math.min(96, recvZ));

                    const dx = recvX - p.position.x;
                    const dz = recvZ - p.position.z;
                    const dist = Math.hypot(dx, dz);
                    const receiveSpeed = aiSpeed * 1.28;

                    if (dist > 0.25) {
                        const step = Math.min(dist, receiveSpeed);
                        p.position.x += (dx / dist) * step;
                        p.position.z += (dz / dist) * step;
                        p.rotation.y = Math.atan2(dx, dz);

                        const legL = p.getObjectByName('legL');
                        const legR = p.getObjectByName('legR');
                        if (legL && legR) {
                            const swing = Math.sin(now * 0.028) * 0.78;
                            legL.rotation.x = swing;
                            legR.rotation.x = -swing;
                        }
                    } else {
                        // 受け取り位置に到達したらボールの方へ体を向けてトラップ体勢に入る
                        p.rotation.y = Math.atan2(ball.position.x - p.position.x, ball.position.z - p.position.z);
                    }
                    return;
                }

                let baseX = (slot.x - 50) * 1.12 + ball.position.x * 0.22;
                let baseZ = (slot.y - 50) * 1.82 + ball.position.z * 0.42;

                if (isRedAttacking) {
                    // 攻撃時サポート & オフサイドライン手前での駆け引き
                    baseZ -= 10;
                    if (baseZ < redAttackOffsideZ + 1.8) {
                        baseZ = redAttackOffsideZ + 1.8;
                    }
                } else {
                    // 守備時：ペナルティエリアから下がりすぎず(最大z=83)、ゴール前に近づくほどボール奪取へ寄せる
                    baseZ = Math.min(83, baseZ + 6);
                    const distToBall = p.position.distanceTo(ball.position);
                    const engageRange = 12 + redGoalDanger * 26;

                    if ((isPressHeld && idx === nearestRedIdx) || (redGoalDanger > 0.2 && distToBall < engageRange)) {
                        const chaseBlend = (isPressHeld && idx === nearestRedIdx) ? 0.95 : (0.35 + redGoalDanger * 0.6);
                        baseX = baseX * (1 - chaseBlend) + ball.position.x * chaseBlend;
                        baseZ = baseZ * (1 - chaseBlend) + Math.min(84, ball.position.z + 0.8) * chaseBlend;
                    }
                }

                baseX = Math.max(-57, Math.min(57, baseX));
                baseZ = Math.max(-96, Math.min(84, baseZ));

                const dx = baseX - p.position.x;
                const dz = baseZ - p.position.z;
                const dist = Math.hypot(dx, dz);
                if (dist > 0.35) {
                    const step = Math.min(dist, aiSpeed);
                    p.position.x += (dx / dist) * step;
                    p.position.z += (dz / dist) * step;
                    p.rotation.y = Math.atan2(dx, dz);

                    const legL = p.getObjectByName('legL');
                    const legR = p.getObjectByName('legR');
                    if (legL && legR) {
                        const swing = Math.sin(now * 0.02) * 0.55;
                        legL.rotation.x = swing;
                        legR.rotation.x = -swing;
                    }
                }
            });

            // 3. 相手CPU / ゲストオンラインプレイヤー (blueTeamPlayers[1..10])
            const guestActiveIdx = (isOnlineMatch && onlineRole === 'host') ? (guestLatestInput.controlledIdx || 10) : -1;

            let cpuCarrierIdx = -1;
            let minCpuDist = 999;
            if (guestActiveIdx !== -1) {
                cpuCarrierIdx = guestActiveIdx;
            } else {
                blueTeamPlayers.forEach((cpu, idx) => {
                    if (idx === 0) return;
                    const d = cpu.position.distanceTo(ball.position);
                    if (d < minCpuDist) {
                        minCpuDist = d;
                        cpuCarrierIdx = idx;
                    }
                });
            }

            let secondCpuIdx = -1;
            let secondCpuDist = 999;
            blueTeamPlayers.forEach((cpu, idx) => {
                if (idx === 0 || idx === cpuCarrierIdx) return;
                const d = cpu.position.distanceTo(ball.position);
                if (d < secondCpuDist) {
                    secondCpuDist = d;
                    secondCpuIdx = idx;
                }
            });

            blueTeamPlayers.forEach((cpu, idx) => {
                if (idx === 0) return;

                // オンライン対戦時はゲスト操作中の選手はゲストの入力位置を優先し、ボール保持時はドリブルを追従させる
                if (isOnlineMatch && onlineRole === 'host' && idx === guestActiveIdx) {
                    if (!hasBallPossession && !isBallInFlight && ball) {
                        const gDirX = Math.sin(cpu.rotation.y);
                        const gDirZ = Math.cos(cpu.rotation.y);
                        const targetBx = cpu.position.x + gDirX * 0.85;
                        const targetBz = cpu.position.z + gDirZ * 0.85;
                        ball.position.x += (targetBx - ball.position.x) * 0.35;
                        ball.position.z += (targetBz - ball.position.z) * 0.35;
                        ball.position.y = 0.75;
                    }
                    return;
                }

                const slot = template[idx] || { x: 50, y: 50 };
                const cpuSpd = 80;
                const aiMoveSpeed = 0.14 + (cpuSpd / 100) * 0.24;

                if (!hasBallPossession && !isBallInFlight && idx === cpuCarrierIdx) {
                    // CPUボール保持者：プレイヤーと同じドリブル速度・タッチ制御で自陣ゴール(z=100)へ攻める
                    let moveDirX = (ball.position.x > 18 ? -0.25 : ball.position.x < -18 ? 0.25 : 0);
                    let moveDirZ = 1.0;

                    if (activePlayer) {
                        const toUserX = activePlayer.position.x - cpu.position.x;
                        const toUserZ = activePlayer.position.z - cpu.position.z;
                        const uDist = Math.hypot(toUserX, toUserZ);
                        if (uDist < 9 && toUserZ > 0) {
                            moveDirX += toUserX > 0 ? -0.55 : 0.55;
                        }
                    }

                    const norm = Math.hypot(moveDirX, moveDirZ) || 1;
                    moveDirX /= norm;
                    moveDirZ /= norm;

                    cpu.position.x = Math.max(-57, Math.min(57, cpu.position.x + moveDirX * aiMoveSpeed));
                    cpu.position.z = Math.max(-96, Math.min(96, cpu.position.z + moveDirZ * aiMoveSpeed));
                    cpu.rotation.y = Math.atan2(moveDirX, moveDirZ);

                    cpuDribbleFrameCounter++;
                    if (cpuDribbleFrameCounter % 20 === 0) {
                        cpuDribbleTouchCount++;
                    }
                    let drbDist = 0.65 + ((100 - 80) / 100) * 1.85;
                    let dribbleControl = Math.min(0.48, 0.14 + (80 / 210));
                    if (cpuDribbleTouchCount >= 3) {
                        drbDist *= 3.0;
                        dribbleControl *= 0.33;
                    }

                    const targetBx = cpu.position.x + moveDirX * drbDist;
                    const targetBz = cpu.position.z + moveDirZ * drbDist;
                    ball.position.x += (targetBx - ball.position.x) * dribbleControl;
                    ball.position.z += (targetBz - ball.position.z) * dribbleControl;
                    ball.position.y = 0.75;

                    // シュート判定（ペナルティエリア付近 z > 58 に侵入したら自然な弾道でシュート）
                    if (cpu.position.z > 58 && Math.random() < 0.032) {
                        const goalX = (Math.random() * 13.6) - 6.8;
                        const dx = goalX - ball.position.x;
                        const dz = 100 - ball.position.z;
                        const d = Math.hypot(dx, dz) || 1;
                        const shotSpd = 1.75 + Math.random() * 0.35;
                        ball.position.y = 0.8;
                        ballVel = { x: (dx / d) * shotSpd, z: (dz / d) * shotSpd, y: 0.18 + Math.random() * 0.12 };
                        isBallInFlight = true;
                        passTargetTeam = null;
                        passTargetPlayerIndex = -1;
                        isThroughPassInFlight = false;
                        lastPasserTeam = 'blue';
                        lastPasserIndex = idx;
                        lastPassTime = now;
                        cpuDribbleTouchCount = 0;
                        cpuDribbleFrameCounter = 0;
                    } else if (Math.random() < 0.018) {
                        // 自分以外の味方フィールド選手から自然なパス先を選択
                        let bestMate = null;
                        let bestMateIdx = -1;
                        let bestScore = -999;

                        blueTeamPlayers.forEach((bm, bIdx) => {
                            if (bIdx === 0 || bIdx === idx) return;
                            const dx = bm.position.x - cpu.position.x;
                            const dz = bm.position.z - cpu.position.z;
                            const dist = Math.hypot(dx, dz);
                            if (dist < 8 || dist > 58) return;
                            if (dz > -6) {
                                const score = dz * 1.4 - Math.abs(dist - 24) * 0.6 + (Math.random() * 10);
                                if (score > bestScore) {
                                    bestScore = score;
                                    bestMate = bm;
                                    bestMateIdx = bIdx;
                                }
                            }
                        });

                        if (bestMate) {
                            cpuOffsidePlayerIndices = [];
                            blueTeamPlayers.forEach((bm, bIdx) => {
                                if (bIdx !== 0 && bIdx !== idx && bm.position.z > blueAttackOffsideZ + 0.5) {
                                    cpuOffsidePlayerIndices.push(bIdx);
                                }
                            });
                            const dx = bestMate.position.x - ball.position.x;
                            const dz = bestMate.position.z - ball.position.z;
                            const d = Math.hypot(dx, dz) || 1;
                            const passSpd = 1.15 + Math.random() * 0.25;
                            ball.position.y = 0.75;
                            ballVel = { x: (dx / d) * passSpd, z: (dz / d) * passSpd, y: 0.03 };
                            isBallInFlight = true;
                            passTargetTeam = 'blue';
                            passTargetPlayerIndex = bestMateIdx;
                            passTargetSpot = { x: bestMate.position.x, z: bestMate.position.z };
                            isThroughPassInFlight = false;
                            lastPasserTeam = 'blue';
                            lastPasserIndex = idx;
                            lastPassTime = now;
                            cpuDribbleTouchCount = 0;
                            cpuDribbleFrameCounter = 0;
                        }
                    }
                    return;
                }

                // CPU側パス受け手もボールに向かって走り込む
                if (isBallInFlight && passTargetTeam === 'blue' && idx === passTargetPlayerIndex) {
                    const recvX = Math.max(-57, Math.min(57, ball.position.x + ballVel.x * 8));
                    const recvZ = Math.max(-96, Math.min(96, ball.position.z + ballVel.z * 8));
                    const dx = recvX - cpu.position.x;
                    const dz = recvZ - cpu.position.z;
                    const dist = Math.hypot(dx, dz);
                    if (dist > 0.25) {
                        const step = Math.min(dist, aiMoveSpeed * 1.15);
                        cpu.position.x += (dx / dist) * step;
                        cpu.position.z += (dz / dist) * step;
                        cpu.rotation.y = Math.atan2(dx, dz);
                    } else {
                        cpu.rotation.y = Math.atan2(ball.position.x - cpu.position.x, ball.position.z - cpu.position.z);
                    }
                    return;
                }

                // CPUサポート＆守備ポジショニング（相手陣形はZ反転）
                let targetX = -(slot.x - 50) * 1.12 + ball.position.x * 0.25;
                let targetZ = -(slot.y - 50) * 1.82 + ball.position.z * 0.42;
                const isBlueAttacking = (!hasBallPossession && !isBallInFlight) || (isBallInFlight && lastPasserTeam === 'blue');

                if (isBlueAttacking) {
                    targetZ += 12;
                    if (targetZ > blueAttackOffsideZ - 1.8) {
                        targetZ = blueAttackOffsideZ - 1.8;
                    }
                } else {
                    targetZ = Math.max(-83, targetZ - 6);
                    const distToBall = cpu.position.distanceTo(ball.position);
                    const engageRange = 14 + cpuGoalDanger * 28;

                    if (idx === cpuCarrierIdx || idx === secondCpuIdx || (cpuGoalDanger > 0.2 && distToBall < engageRange)) {
                        const chaseBlend = (idx === cpuCarrierIdx)
                            ? (0.65 + cpuGoalDanger * 0.35)
                            : (0.3 + cpuGoalDanger * 0.55);
                        const interceptZ = Math.max(-84, ball.position.z - 0.9);
                        targetX = targetX * (1 - chaseBlend) + ball.position.x * chaseBlend;
                        targetZ = targetZ * (1 - chaseBlend) + interceptZ * chaseBlend;
                    }
                }

                targetX = Math.max(-57, Math.min(57, targetX));
                targetZ = Math.max(-84, Math.min(96, targetZ));

                const dx = targetX - cpu.position.x;
                const dz = targetZ - cpu.position.z;
                const dist = Math.hypot(dx, dz);
                if (dist > 0.35) {
                    const step = Math.min(dist, aiMoveSpeed * 0.92);
                    cpu.position.x += (dx / dist) * step;
                    cpu.position.z += (dz / dist) * step;
                    cpu.rotation.y = Math.atan2(dx, dz);
                }
            });
        }

        function alignKickoffFormation() {
            const template = formationTemplates[currentFormation] || formationTemplates['433'];

            redTeamPlayers.forEach((p, idx) => {
                const slot = template[idx] || { x: 50, y: 50 };
                if (idx === 0) {
                    p.position.set(0, 0, 96.5);
                } else if (idx === 10) {
                    p.position.set(0, 0, 1.2);
                } else {
                    const kx = (slot.x - 50) * 1.1;
                    const kz = Math.max(4, (slot.y - 45) * 1.65);
                    p.position.set(kx, 0, kz);
                }
                p.rotation.y = Math.PI;
            });

            blueTeamPlayers.forEach((p, idx) => {
                const slot = template[idx] || { x: 50, y: 50 };
                if (idx === 0) {
                    p.position.set(0, 0, -96.5);
                } else {
                    const kx = -(slot.x - 50) * 1.1;
                    const kz = Math.min(-6, -(slot.y - 45) * 1.65);
                    p.position.set(kx, 0, kz);
                }
                p.rotation.y = 0;
            });

            if (ball) {
                ball.position.set(0, 0.75, 0);
            }
            ballVel = { x: 0, z: 0, y: 0 };
            controlledPlayerIndex = 10;
            hasBallPossession = true;
            isBallInFlight = false;
            isGkHoldingBall = false;
            isFreeKickHolding = false;
            const gkBanner = document.getElementById('gkPassBanner');
            if (gkBanner) gkBanner.classList.add('hidden');
            const fkBanner = document.getElementById('freeKickBanner');
            if (fkBanner) fkBanner.classList.add('hidden');
            if (gkTargetRing) gkTargetRing.visible = false;
            if (fkAimLine) fkAimLine.visible = false;
            passTargetTeam = null;
            passTargetPlayerIndex = -1;
            isThroughPassInFlight = false;
            isKickoff = true;
            isKickoffWait = true;
            offsidePlayerIndices = [];
            cpuOffsidePlayerIndices = [];
            playerDribbleTouchCount = 0;
            playerDribbleFrameCounter = 0;
            cpuDribbleTouchCount = 0;
            cpuDribbleFrameCounter = 0;

            const kb = document.getElementById('kickoffBanner');
            if (kb) kb.classList.remove('opacity-0');

            // キックオフ開始1秒待機
            setTimeout(() => {
                isKickoffWait = false;
            }, 1000);
        }

        function checkGoalAndBounds() {
            if (!ball || isGoalPause || isGkSaving || isOffsideFlagged) return;

            // ゴール判定（ゴール幅 15.0 = ±7.5）
            if (ball.position.z < -100 && Math.abs(ball.position.x) < 7.5 && ball.position.y < 4.2) {
                triggerGoal('red');
                return;
            }
            if (ball.position.z > 100 && Math.abs(ball.position.x) < 7.5 && ball.position.y < 4.2) {
                triggerGoal('blue');
                return;
            }

            // タッチライン・ゴールライン割れのルーズリスタート（ワープなし）
            if (Math.abs(ball.position.x) > 60 || Math.abs(ball.position.z) > 100) {
                ball.position.x = Math.max(-58.5, Math.min(58.5, ball.position.x));
                ball.position.z = Math.max(-98.5, Math.min(98.5, ball.position.z));
                ball.position.y = 0.75;
                ballVel = { x: 0, z: 0, y: 0 };
                isBallInFlight = false;
                passTargetTeam = null;
                passTargetPlayerIndex = -1;
                isThroughPassInFlight = false;
                offsidePlayerIndices = [];
                cpuOffsidePlayerIndices = [];
                hasBallPossession = (lastPasserTeam !== 'red');
            }
        }

        function triggerGoal(scoringTeam) {
            if (isGoalPause) return;
            isGoalPause = true;
            isBallInFlight = false;
            ballVel = { x: 0, z: 0, y: 0 };

            const isGuestClient = isOnlineMatch && onlineRole === 'guest';
            const isMyGoal = isGuestClient ? (scoringTeam === 'blue') : (scoringTeam === 'red');

            const scorerText = document.getElementById('scorerText');
            if (scoringTeam === 'red') {
                scoreRed++;
                document.getElementById('scoreRed').innerText = String(scoreRed);
                if (isMyGoal) {
                    const scorer = myTeamSquad[controlledPlayerIndex];
                    const sName = scorer ? getDisplayPlayerName(scorer.name) : 'TOKYO FC';
                    if (scorerText) scorerText.innerText = `${sName} SCORED! (+50 Coins / +1,000 GP)`;
                    userCoins += 50;
                    userGP += 1000;
                    updateCurrencyDisplays();
                    if (window.saveCloudData) window.saveCloudData(true);
                } else {
                    if (scorerText) scorerText.innerText = 'TOKYO FC SCORED!';
                }
            } else {
                scoreBlue++;
                document.getElementById('scoreBlue').innerText = String(scoreBlue);
                if (isMyGoal) {
                    const scorer = myTeamSquad[controlledPlayerIndex];
                    const sName = scorer ? getDisplayPlayerName(scorer.name) : 'WORLD XI';
                    if (scorerText) scorerText.innerText = `${sName} SCORED! (+50 Coins / +1,000 GP)`;
                    userCoins += 50;
                    userGP += 1000;
                    updateCurrencyDisplays();
                    if (window.saveCloudData) window.saveCloudData(true);
                } else {
                    if (scorerText) scorerText.innerText = 'WORLD XI SCORED!';
                }
            }

            const gb = document.getElementById('goalBanner');
            if (gb) gb.classList.remove('hidden');

            // ゴール後3秒でキックオフ画面へ自動移行
            setTimeout(() => {
                if (gb) gb.classList.add('hidden');
                isGoalPause = false;
                if (isMatchRunning) {
                    alignKickoffFormation();
                }
            }, 3000);
        }

        function updateHUDAndRadar() {
            const lblTR = document.getElementById('labelTopRight');
            const lblTL = document.getElementById('labelTopLeft');
            const lblBR = document.getElementById('labelBtmRight');
            const lblBL = document.getElementById('labelBtmLeft');

            // 攻守切り替えによるボタンラベル更新
            if (isGkHoldingBall) {
                if (lblTR) lblTR.innerText = 'THROUGH';
                if (lblTL) lblTL.innerText = 'PUNT';
                if (lblBR) lblBR.innerText = 'PASS';
                if (lblBL) lblBL.innerText = '---';
            } else if (isFreeKickHolding) {
                if (lblTR) lblTR.innerText = 'THROUGH';
                if (lblTL) lblTL.innerText = 'LONG';
                if (lblBR) lblBR.innerText = 'PASS';
                if (lblBL) lblBL.innerText = '---';
            } else if (hasBallPossession) {
                if (lblTR) lblTR.innerText = 'THROUGH';
                if (lblTL) lblTL.innerText = 'SHOOT';
                if (lblBR) lblBR.innerText = 'PASS';
                if (lblBL) lblBL.innerText = 'DASH';
            } else {
                if (lblTR) lblTR.innerText = 'MATCH UP';
                if (lblTL) lblTL.innerText = 'PRESS';
                if (lblBR) lblBR.innerText = 'CURSOR';
                if (lblBL) lblBL.innerText = 'DASH';
                stopCharge();
            }

            // 操作選手バッジ更新
            const slotTemplate = formationTemplates[currentFormation] || formationTemplates['433'];
            const currentSlotPos = (slotTemplate[controlledPlayerIndex] || {}).pos;
            const pData = myTeamSquad[controlledPlayerIndex] || { name: '選手', pos: 'MF', ovr: 80 };
            const effStats = getEffectivePlayerStats(pData, currentSlotPos);
            const dispPlayerName = getDisplayPlayerName(pData.name);
            const posEl = document.getElementById('activePlayerPos');
            const nameEl = document.getElementById('activePlayerName');
            const ovrEl = document.getElementById('activePlayerOvr');
            if (posEl) {
                posEl.innerText = currentSlotPos || pData.pos;
                posEl.className = effStats.isCompat
                    ? 'bg-ef-cyan text-black text-[10px] font-black px-1.5 py-0.2 rounded'
                    : 'bg-red-600 text-white text-[10px] font-black px-1.5 py-0.2 rounded';
            }
            if (nameEl) nameEl.innerText = dispPlayerName;
            if (ovrEl) {
                ovrEl.innerText = effStats.isCompat ? `OVR ${effStats.ovr}` : `OVR ${effStats.ovr} (! )`;
                ovrEl.className = effStats.isCompat ? 'text-[10px] font-black text-ef-yellow' : 'text-[10px] font-black text-red-400';
            }

            // 試合中の操作選手頭上ネームタグ追従（ダッシュ時はオレンジ＋⚡表示）
            const isGuestClient = isOnlineMatch && onlineRole === 'guest';
            const activeMesh = isGuestClient ? blueTeamPlayers[controlledPlayerIndex] : redTeamPlayers[controlledPlayerIndex];
            const tagEl = document.getElementById('overheadPlayerTag');
            if (activeMesh && camera && tagEl) {
                const headPos = new THREE.Vector3(
                    activeMesh.position.x,
                    activeMesh.position.y + 4.35,
                    activeMesh.position.z
                );
                headPos.project(camera);

                if (headPos.z < 1) {
                    const sx = (headPos.x * 0.5 + 0.5) * window.innerWidth;
                    const sy = (-headPos.y * 0.5 + 0.5) * window.innerHeight;
                    tagEl.style.left = `${sx}px`;
                    tagEl.style.top = `${sy}px`;
                    if (isDashPressed && Math.hypot(inputVector.x, inputVector.z) > 0.05) {
                        tagEl.innerText = `⚡ ${dispPlayerName}`;
                        tagEl.className = 'absolute z-30 pointer-events-none px-2.5 py-0.5 bg-amber-950/95 border border-amber-400 text-amber-300 font-extrabold text-[11px] rounded-full shadow-lg whitespace-nowrap transform -translate-x-1/2 -translate-y-full transition-transform duration-75';
                    } else {
                        tagEl.innerText = dispPlayerName;
                        tagEl.className = 'absolute z-30 pointer-events-none px-2.5 py-0.5 bg-slate-950/90 border border-cyan-400 text-cyan-300 font-extrabold text-[11px] rounded-full shadow-lg whitespace-nowrap transform -translate-x-1/2 -translate-y-full transition-transform duration-75';
                    }
                } else {
                    tagEl.classList.add('hidden');
                }
            }

            // ミニマップレーダー描画
            const radar = document.getElementById('radarCanvas');
            if (radar) {
                const ctx = radar.getContext('2d');
                const w = radar.width;
                const h = radar.height;
                ctx.clearRect(0, 0, w, h);

                ctx.strokeStyle = 'rgba(0, 240, 255, 0.35)';
                ctx.lineWidth = 1.5;
                ctx.strokeRect(4, 4, w - 8, h - 8);
                ctx.beginPath();
                ctx.moveTo(w / 2, 4);
                ctx.lineTo(w / 2, h - 4);
                ctx.stroke();

                const mapToRadar = (px, pz) => isGuestClient
                    ? ({ rx: w / 2 + (pz / 100) * (w / 2 - 8), ry: h / 2 + (-px / 60) * (h / 2 - 8) })
                    : ({ rx: w / 2 + (-pz / 100) * (w / 2 - 8), ry: h / 2 + (px / 60) * (h / 2 - 8) });

                redTeamPlayers.forEach((p, idx) => {
                    const { rx, ry } = mapToRadar(p.position.x, p.position.z);
                    const isSelectTarget = (isGkHoldingBall && idx === gkTargetPlayerIdx) || (isFreeKickHolding && idx === fkTargetPlayerIdx);
                    ctx.fillStyle = isSelectTarget ? '#facc15' : ((!isGuestClient && idx === controlledPlayerIndex) ? '#ccff00' : '#ef4444');
                    ctx.beginPath();
                    ctx.arc(rx, ry, (isSelectTarget || (!isGuestClient && idx === controlledPlayerIndex)) ? 4.5 : 3.2, 0, Math.PI * 2);
                    ctx.fill();
                });

                blueTeamPlayers.forEach((p, idx) => {
                    const { rx, ry } = mapToRadar(p.position.x, p.position.z);
                    ctx.fillStyle = (isGuestClient && idx === controlledPlayerIndex) ? '#ccff00' : '#3b82f6';
                    ctx.beginPath();
                    ctx.arc(rx, ry, (isGuestClient && idx === controlledPlayerIndex) ? 4.2 : 3.2, 0, Math.PI * 2);
                    ctx.fill();
                });

                if (ball) {
                    const { rx, ry } = mapToRadar(ball.position.x, ball.position.z);
                    ctx.fillStyle = '#ffffff';
                    ctx.beginPath();
                    ctx.arc(rx, ry, 3.0, 0, Math.PI * 2);
                    ctx.fill();
                }
            }
        }

        // =========================================================================
        // 9. TOUCH JOYSTICK & KEYBOARD INPUT HANDLERS
        // =========================================================================
        (function setupControls() {
            const zone = document.getElementById('joystickZone');
            const base = document.getElementById('joystickBase');
            const stick = document.getElementById('joystickStick');
            let isDragging = false;
            let activeTouchId = null;
            let originClientX = 0;
            let originClientY = 0;
            const maxRadius = 54;
            const baseRadius = 82;
            const centerOffset = 48;

            function placeJoystickAt(clientX, clientY) {
                if (!zone || !base || !stick) return;
                const zoneRect = zone.getBoundingClientRect();

                // 指を置いた画面座標へベース中心を配置（画面端からはみ出さないよう余白を確保）
                const minScreenX = Math.max(zoneRect.left + baseRadius * 0.75, 76);
                const maxScreenX = Math.min(zoneRect.right - baseRadius * 0.5, window.innerWidth * 0.48);
                const minScreenY = Math.max(zoneRect.top + baseRadius * 0.6, 90);
                const maxScreenY = Math.min(zoneRect.bottom - baseRadius * 0.75, window.innerHeight - 76);

                originClientX = Math.max(minScreenX, Math.min(maxScreenX, clientX));
                originClientY = Math.max(minScreenY, Math.min(maxScreenY, clientY));

                const relLeft = (originClientX - zoneRect.left) - baseRadius;
                const relTop = (originClientY - zoneRect.top) - baseRadius;

                base.style.bottom = 'auto';
                base.style.left = `${relLeft}px`;
                base.style.top = `${relTop}px`;
                base.classList.add('joystick-active');

                stick.style.left = `${centerOffset}px`;
                stick.style.top = `${centerOffset}px`;
            }

            function updateStick(clientX, clientY) {
                if (!stick) return;
                let dx = clientX - originClientX;
                let dy = clientY - originClientY;
                const dist = Math.hypot(dx, dy);
                if (dist > maxRadius) {
                    dx = (dx / dist) * maxRadius;
                    dy = (dy / dist) * maxRadius;
                }
                stick.style.left = `${centerOffset + dx}px`;
                stick.style.top = `${centerOffset + dy}px`;
                inputVector.x = dx / maxRadius;
                inputVector.z = dy / maxRadius;
            }

            function resetStick() {
                isDragging = false;
                activeTouchId = null;
                if (base) {
                    base.classList.remove('joystick-active');
                    base.style.top = 'auto';
                    base.style.left = '24px';
                    base.style.bottom = '24px';
                }
                if (stick) {
                    stick.style.left = `${centerOffset}px`;
                    stick.style.top = `${centerOffset}px`;
                }
                inputVector.x = 0;
                inputVector.z = 0;
            }

            if (zone) {
                zone.addEventListener('touchstart', (e) => {
                    e.preventDefault();
                    const t = e.changedTouches[0];
                    activeTouchId = t.identifier;
                    isDragging = true;
                    placeJoystickAt(t.clientX, t.clientY);
                    updateStick(t.clientX, t.clientY);
                }, { passive: false });

                zone.addEventListener('touchmove', (e) => {
                    e.preventDefault();
                    for (let i = 0; i < e.changedTouches.length; i++) {
                        const t = e.changedTouches[i];
                        if (t.identifier === activeTouchId) {
                            updateStick(t.clientX, t.clientY);
                            break;
                        }
                    }
                }, { passive: false });

                zone.addEventListener('touchend', (e) => {
                    for (let i = 0; i < e.changedTouches.length; i++) {
                        if (e.changedTouches[i].identifier === activeTouchId) {
                            resetStick();
                            break;
                        }
                    }
                });

                zone.addEventListener('touchcancel', resetStick);

                zone.addEventListener('mousedown', (e) => {
                    isDragging = true;
                    placeJoystickAt(e.clientX, e.clientY);
                    updateStick(e.clientX, e.clientY);
                });
                window.addEventListener('mousemove', (e) => {
                    if (isDragging) updateStick(e.clientX, e.clientY);
                });
                window.addEventListener('mouseup', () => {
                    if (isDragging) resetStick();
                });
            }

            const keysPressed = {};
            function recalcKeyInput() {
                let kx = 0;
                let kz = 0;
                if (keysPressed['KeyA'] || keysPressed['ArrowLeft']) kx -= 1;
                if (keysPressed['KeyD'] || keysPressed['ArrowRight']) kx += 1;
                if (keysPressed['KeyW'] || keysPressed['ArrowUp']) kz -= 1;
                if (keysPressed['KeyS'] || keysPressed['ArrowDown']) kz += 1;
                const mag = Math.hypot(kx, kz);
                if (mag > 0) {
                    inputVector.x = kx / mag;
                    inputVector.z = kz / mag;
                } else if (!isDragging) {
                    inputVector.x = 0;
                    inputVector.z = 0;
                }
            }

            window.addEventListener('keydown', (e) => {
                if (!isMatchRunning) return;
                keysPressed[e.code] = true;
                recalcKeyInput();
                if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') setDashState(true);
                if (e.code === 'KeyJ' && !e.repeat) handleBtnDown(null, 'btmRight');
                if (e.code === 'KeyK' && !e.repeat) handleBtnDown(null, 'topRight');
                if (e.code === 'KeyL' && !e.repeat) handleBtnDown(null, 'topLeft');
            });

            window.addEventListener('keyup', (e) => {
                delete keysPressed[e.code];
                recalcKeyInput();
                if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') setDashState(false);
                if (!isMatchRunning) return;
                if (e.code === 'KeyJ') handleBtnUp(null, 'btmRight');
                if (e.code === 'KeyK') handleBtnUp(null, 'topRight');
                if (e.code === 'KeyL') handleBtnUp(null, 'topLeft');
            });
        })();

