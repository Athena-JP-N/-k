            } else {
                if (packsBtn) packsBtn.className = 'px-4 py-1.5 rounded-full text-xs font-black bg-purple-500 text-white transition-all';
                if (shopBtn) shopBtn.className = 'px-4 py-1.5 rounded-full text-xs font-black text-cyan-300 hover:text-white transition-all';
                if (packTabs) packTabs.classList.remove('hidden');
                if (boxCard) boxCard.classList.remove('hidden');
                if (shopCard) shopCard.classList.add('hidden');
            }
