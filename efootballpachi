        window.saveCloudData = async function(silent = true) {
            const payload = {
                currentLang: currentLang || 'ja',
                userCoins: Number(userCoins) || 0,
                userGP: Number(userGP) || 0,
                currentFormation: currentFormation || '433',
                myTeamSquad: JSON.parse(JSON.stringify(myTeamSquad)),
                reservePlayers: JSON.parse(JSON.stringify(reservePlayers)),
                boxRemainingCounts: { ...boxRemainingCounts },
                drawnPlayersByPack: {
                    all_national_vol1: Array.from(drawnPlayersByPack.all_national_vol1 || []),
                    all_national_vol2: Array.from(drawnPlayersByPack.all_national_vol2 || []),
                    japanese_stars: Array.from(drawnPlayersByPack.japanese_stars || []),
                    england_stars: Array.from(drawnPlayersByPack.england_stars || []),
                    history_legends_vol1: Array.from(drawnPlayersByPack.history_legends_vol1 || []),
                    active_duty_attackers: Array.from(drawnPlayersByPack.active_duty_attackers || []),
                    active_duty_defencers: Array.from(drawnPlayersByPack.active_duty_defencers || [])
                },
                updatedAt: Date.now()
            };

            try {
                localStorage.setItem('efootball_2026_save_v1', JSON.stringify(payload));
            } catch (_) {}

            const pvp = window.FirebasePvP;
            if (!pvp || !pvp.ready || !pvp.user || !pvp.db) {
                const now = new Date();
                const hh = String(now.getHours()).padStart(2, '0');
                const mm = String(now.getMinutes()).padStart(2, '0');
                updateSaveStatusUI(`LOCAL SAVED (${hh}:${mm})`, 'text-emerald-300 border-emerald-400/50');
                return;
            }

            try {
                if (!silent) {
                    updateSaveStatusUI('セーブ中...', 'text-cyan-300 border-cyan-400/60');
                }
                const { doc, setDoc } = pvp.fns;
                const userId = pvp.user.uid;
                const saveRef = doc(pvp.db, 'artifacts', pvp.appId, 'users', userId, 'save_data', 'profile');

                await setDoc(saveRef, payload);
                const now = new Date();
                const hh = String(now.getHours()).padStart(2, '0');
                const mm = String(now.getMinutes()).padStart(2, '0');
                updateSaveStatusUI(`SAVED (${hh}:${mm})`, 'text-emerald-300 border-emerald-400/50');
            } catch (err) {
                updateSaveStatusUI('LOCAL SAVED', 'text-amber-300 border-amber-400/40');
            }
        };

        function applyLoadedSaveObject(data) {
            if (!data) return;
            if (data.currentLang === 'en' || data.currentLang === 'ja') currentLang = data.currentLang;
            if (typeof data.userCoins === 'number') userCoins = data.userCoins;
            if (typeof data.userGP === 'number') userGP = data.userGP;
            if (data.currentFormation && formationTemplates[data.currentFormation]) {
                currentFormation = data.currentFormation;
                const sel = document.getElementById('formationSelect');
                if (sel) sel.value = currentFormation;
            }
            if (Array.isArray(data.myTeamSquad) && data.myTeamSquad.length === 11) {
                myTeamSquad = data.myTeamSquad;
            }
            if (Array.isArray(data.reservePlayers)) {
                reservePlayers = data.reservePlayers;
            }
            if (data.boxRemainingCounts) {
                boxRemainingCounts = {
                    all_national_vol1: data.boxRemainingCounts.all_national_vol1 ?? 250,
                    all_national_vol2: data.boxRemainingCounts.all_national_vol2 ?? 250,
                    japanese_stars: data.boxRemainingCounts.japanese_stars ?? 200,
                    england_stars: data.boxRemainingCounts.england_stars ?? 200,
                    history_legends_vol1: data.boxRemainingCounts.history_legends_vol1 ?? 150,
                    active_duty_attackers: data.boxRemainingCounts.active_duty_attackers ?? 150,
                    active_duty_defencers: data.boxRemainingCounts.active_duty_defencers ?? 150
                };
            }
            if (data.drawnPlayersByPack) {
                drawnPlayersByPack = {
                    all_national_vol1: new Set(data.drawnPlayersByPack.all_national_vol1 || []),
                    all_national_vol2: new Set(data.drawnPlayersByPack.all_national_vol2 || []),
                    japanese_stars: new Set(data.drawnPlayersByPack.japanese_stars || []),
                    england_stars: new Set(data.drawnPlayersByPack.england_stars || []),
                    history_legends_vol1: new Set(data.drawnPlayersByPack.history_legends_vol1 || []),
                    active_duty_attackers: new Set(data.drawnPlayersByPack.active_duty_attackers || []),
                    active_duty_defencers: new Set(data.drawnPlayersByPack.active_duty_defencers || [])
                };
            }
            updateCurrencyDisplays();
            applyLanguage(currentLang);
        }

        window.loadCloudSaveData = async function() {
            const pvp = window.FirebasePvP;
            if (!pvp || !pvp.ready || !pvp.user || !pvp.db) {
                try {
                    const localRaw = localStorage.getItem('efootball_2026_save_v1');
                    if (localRaw) {
                        applyLoadedSaveObject(JSON.parse(localRaw));
                        updateSaveStatusUI('LOCAL SAVE LOADED', 'text-emerald-300 border-emerald-400/50');
                    } else {
                        updateSaveStatusUI('LOCAL SAVE READY', 'text-emerald-300 border-emerald-400/50');
                    }
                } catch (_) {
                    updateSaveStatusUI('LOCAL SAVE READY', 'text-emerald-300 border-emerald-400/50');
                }
                return;
            }

            try {
                updateSaveStatusUI('データ読込中...', 'text-cyan-300 border-cyan-400/50');
                const { doc, getDoc } = pvp.fns;
                const userId = pvp.user.uid;
                const saveRef = doc(pvp.db, 'artifacts', pvp.appId, 'users', userId, 'save_data', 'profile');
                const snap = await getDoc(saveRef);

                if (snap.exists()) {
                    applyLoadedSaveObject(snap.data());
                    updateSaveStatusUI('SAVED DATA LOADED', 'text-emerald-300 border-emerald-400/50');
                } else {
                    const localRaw = localStorage.getItem('efootball_2026_save_v1');
                    if (localRaw) {
                        applyLoadedSaveObject(JSON.parse(localRaw));
                    }
                    await window.saveCloudData(true);
                }
            } catch (err) {
                updateSaveStatusUI('読込エラー', 'text-red-300 border-red-400/50');
            }
        };

