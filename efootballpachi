        function drawGacha(packKey, count) {
            const pack = gachaDatabase[packKey];
            if (!pack) return;

            const cost = count === 10 ? 900 : 100;
            if (userCoins < cost) {
                const msgEl = document.getElementById('gachaMessageText');
                if (msgEl) {
                    msgEl.innerText = currentLang === 'en' ? 'Not enough Coins!' : 'コインが不足しています！';
                    msgEl.className = 'text-center text-xs font-black text-red-400';
                }
                return;
            }

            const drawnSet = drawnPlayersByPack[packKey];
            userCoins -= cost;
            updateCurrencyDisplays();
            currentGachaResults = [];

            for (let i = 0; i < count; i++) {
                let rem = boxRemainingCounts[packKey];
                if (rem <= 0) {
                    boxRemainingCounts[packKey] = pack.totalBox;
                    drawnSet.clear();
                    rem = pack.totalBox;
                }

                // 未排出の目玉・ハイライト選手を抽出（重複なし）
                const availPickups = pack.pickups.filter(p => !drawnSet.has(p.name));
                const availHighlights = pack.highlights.filter(p => !drawnSet.has(p.name));
                const availStandards = pack.standards;

                let pulled = null;
                let isCeilingHit = false;

                // 全キャラ均等のBOX排出率（250BOXなら初期1/250、残数rem減少に伴い1/rem）
                const slotIndex = Math.floor(Math.random() * rem);

                if (slotIndex < availPickups.length) {
                    pulled = { ...availPickups[slotIndex] };
                    drawnSet.add(pulled.name);
                    if (rem <= availPickups.length) isCeilingHit = true;
                } else if (slotIndex < availPickups.length + availHighlights.length) {
                    pulled = { ...availHighlights[slotIndex - availPickups.length] };
                    drawnSet.add(pulled.name);
                } else {
                    pulled = { ...availStandards[Math.floor(Math.random() * availStandards.length)] };
                }

                boxRemainingCounts[packKey] = Math.max(0, rem - 1);
                reservePlayers.unshift({ ...pulled });
                currentGachaResults.push({
                    player: pulled,
                    revealed: false,
                    isCeilingHit
                });
            }

            updateBoxCounterUI();
            renderGachaPickupList();
            renderGachaModal();
            const modal = document.getElementById('gachaResultModal');
            if (modal) modal.classList.remove('hidden');
            if (window.saveCloudData) window.saveCloudData(true);
        }

