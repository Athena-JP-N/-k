        function startOnlineMatchClient(role, roomId) {
            if (roomsListUnsubscribe) {
                roomsListUnsubscribe();
                roomsListUnsubscribe = null;
            }

            isOnlineMatch = true;
            onlineRole = role;
            currentOnlineRoomId = roomId;
            isMatchFinished = false;

            hideAllScreens();
            document.getElementById('screenMatch').classList.remove('hidden');

            scoreRed = 0;
            scoreBlue = 0;
            matchTimeSeconds = 0;
            document.getElementById('scoreRed').innerText = '0';
            document.getElementById('scoreBlue').innerText = '0';
            updateMatchTimerDisplay();

            if (!scene) {
                init3DScene();
            } else {
                createTeamPlayers();
            }
            onWindowResize();
            alignKickoffFormation();
            isMatchRunning = true;

            if (matchTimerInterval) clearInterval(matchTimerInterval);
            matchTimerInterval = setInterval(() => {
                if (!isMatchRunning || isKickoff || isKickoffWait || isGoalPause || isOffsideFlagged || isMatchFinished) return;
                if (onlineRole === 'host') {
                    matchTimeSeconds++;
                }
                updateMatchTimerDisplay();
                if (matchTimeSeconds >= MATCH_DURATION_SECONDS) {
                    finishMatch();
                }
            }, 1000);

            if (animationFrameId) cancelAnimationFrame(animationFrameId);
            animateMatch();
        }

        function pushOnlineStateIfNeeded(now, actionPayload = null) {
            const pvp = window.FirebasePvP;
            if (!isOnlineMatch || !pvp || !pvp.ready || !pvp.db || !currentOnlineRoomId) return;
            if (!actionPayload && now - lastOnlineSyncPushTime < 75) return;
            lastOnlineSyncPushTime = now;

            const { doc, updateDoc } = pvp.fns;
            const roomRef = doc(pvp.db, 'artifacts', pvp.appId, 'public', 'data', 'pvp_rooms', currentOnlineRoomId);

            if (onlineRole === 'host') {
                updateDoc(roomRef, {
                    scoreRed,
                    scoreBlue,
                    matchTimeSeconds,
                    hasBallPossession,
                    isBallInFlight,
                    isGkSaving,
                    ball: ball ? { x: ball.position.x, y: ball.position.y, z: ball.position.z } : { x: 0, y: 0.75, z: 0 },
                    redPlayers: redTeamPlayers.map(p => ({ x: p.position.x, z: p.position.z, r: p.rotation.y })),
                    bluePlayers: blueTeamPlayers.map(p => ({ x: p.position.x, z: p.position.z, r: p.rotation.y }))
                }).catch(() => {});
            } else if (onlineRole === 'guest') {
                const myMesh = blueTeamPlayers[controlledPlayerIndex];
                const payload = {
                    controlledIdx: controlledPlayerIndex,
                    x: myMesh ? myMesh.position.x : 0,
                    z: myMesh ? myMesh.position.z : -1.2,
                    rotY: myMesh ? myMesh.rotation.y : 0,
                    inputX: inputVector.x,
                    inputZ: inputVector.z,
                    isDash: isDashPressed,
                    isMatchUp: isMatchUpHeld,
                    isPress: isPressHeld,
                    actionId: actionPayload ? actionPayload.actionId : guestLatestInput.actionId,
                    actionType: actionPayload ? actionPayload.actionType : null,
                    powerRatio: actionPayload ? actionPayload.powerRatio : 0.5,
                    aimX: actionPayload ? actionPayload.aimX : 0,
                    aimZ: actionPayload ? actionPayload.aimZ : 1
                };
                guestLatestInput = payload;
                updateDoc(roomRef, { guestInput: payload }).catch(() => {});
            }
        }

        function applyGuestInputOnHost(gInput) {
            if (!gInput) return;
            guestLatestInput = gInput;
            const gIdx = gInput.controlledIdx || 10;
            const gMesh = blueTeamPlayers[gIdx];
            if (gMesh && typeof gInput.x === 'number' && typeof gInput.z === 'number') {
                gMesh.position.x = gInput.x;
                gMesh.position.z = gInput.z;
                gMesh.rotation.y = gInput.rotY || 0;
            }

            if (gInput.actionId && gInput.actionId !== lastProcessedGuestActionId) {
                lastProcessedGuestActionId = gInput.actionId;
                if (gInput.actionType === 'matchup_steal' && hasBallPossession && gMesh && ball) {
                    if (gMesh.position.distanceTo(ball.position) < 2.65) {
                        hasBallPossession = false;
                        lastPossessionChangeTime = Date.now();
                    }
                } else if (!hasBallPossession && !isBallInFlight && ball) {
                    const pRatio = gInput.powerRatio || 0.5;
                    const ax = gInput.aimX || 0;
                    const az = gInput.aimZ || 1;
                    if (gInput.actionType === 'btmRight') {
                        const spd = 1.0 + pRatio * 0.65;
                        ballVel = { x: ax * spd, z: az * spd, y: 0.04 };
                        isBallInFlight = true;
                        lastPasserTeam = 'blue';
                        lastPasserIndex = gIdx;
                        lastPassTime = Date.now();
                    } else if (gInput.actionType === 'topRight') {
                        const spd = 1.2 + pRatio * 0.75;
                        ballVel = { x: ax * spd, z: az * spd, y: 0.03 };
                        isBallInFlight = true;
                        lastPasserTeam = 'blue';
                        lastPasserIndex = gIdx;
                        lastPassTime = Date.now();
                    } else if (gInput.actionType === 'topLeft') {
                        const dx = Math.max(-6.8, Math.min(6.8, ax * 7.2)) - ball.position.x;
                        const dz = 100 - ball.position.z;
                        const d = Math.hypot(dx, dz) || 1;
                        const shotSpd = 1.65 + pRatio * 0.95;
                        ballVel = { x: (dx / d) * shotSpd, z: (dz / d) * shotSpd, y: 0.16 + pRatio * 0.22 };
                        isBallInFlight = true;
                        lastPasserTeam = 'blue';
                        lastPasserIndex = gIdx;
                        lastPassTime = Date.now();
                    }
                }
            }
        }

        function applyHostStateOnGuest(state) {
            if (!state) return;
            if (typeof state.scoreRed === 'number') {
                if (state.scoreRed > scoreRed) {
                    scoreRed = state.scoreRed;
                    const sr = document.getElementById('scoreRed');
                    if (sr) sr.innerText = String(scoreRed);
                } else {
                    scoreRed = state.scoreRed;
                    const sr = document.getElementById('scoreRed');
                    if (sr) sr.innerText = String(scoreRed);
                }
            }
            if (typeof state.scoreBlue === 'number') {
                if (state.scoreBlue > scoreBlue && !isMatchFinished) {
                    userCoins += 50;
                    userGP += 1000;
                    updateCurrencyDisplays();
                    if (window.saveCloudData) window.saveCloudData(true);
                }
                scoreBlue = state.scoreBlue;
                const sb = document.getElementById('scoreBlue');
                if (sb) sb.innerText = String(scoreBlue);
            }
            if (typeof state.matchTimeSeconds === 'number') {
                matchTimeSeconds = state.matchTimeSeconds;
                updateMatchTimerDisplay();
                if (matchTimeSeconds >= MATCH_DURATION_SECONDS && !isMatchFinished) {
                    finishMatch();
                }
            }
            // ゲスト視点では「自分がボール保持中」は !state.hasBallPossession
            hasBallPossession = !state.hasBallPossession;
            isBallInFlight = Boolean(state.isBallInFlight);

            // オンライン対戦時のGKセーブバナー同期表示
            const guestSaveBanner = document.getElementById('saveBanner');
            if (guestSaveBanner) {
                if (state.isGkSaving) {
                    const shootB = document.getElementById('shootBanner');
                    if (shootB) shootB.classList.add('hidden');
                    guestSaveBanner.classList.remove('hidden');
                } else {
                    guestSaveBanner.classList.add('hidden');
                }
            }

            if (ball && state.ball) {
                ball.position.set(state.ball.x, state.ball.y, state.ball.z);
            }
            if (Array.isArray(state.redPlayers)) {
                state.redPlayers.forEach((rp, idx) => {
                    if (redTeamPlayers[idx]) {
                        redTeamPlayers[idx].position.x = rp.x;
                        redTeamPlayers[idx].position.z = rp.z;
                        redTeamPlayers[idx].rotation.y = rp.r;
                    }
                });
            }
            if (Array.isArray(state.bluePlayers)) {
                state.bluePlayers.forEach((bp, idx) => {
                    if (idx === controlledPlayerIndex) return;
                    if (blueTeamPlayers[idx]) {
                        blueTeamPlayers[idx].position.x = bp.x;
                        blueTeamPlayers[idx].position.z = bp.z;
                        blueTeamPlayers[idx].rotation.y = bp.r;
                    }
                });
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            try {
                const localRaw = localStorage.getItem('efootball_2026_save_v1');
                if (localRaw) {
                    const parsed = JSON.parse(localRaw);
                    if (parsed && (parsed.currentLang === 'en' || parsed.currentLang === 'ja')) {
                        currentLang = parsed.currentLang;
                    }
                }
            } catch (_) {}
            applyLanguage(currentLang);
            if (window.loadCloudSaveData) {
                window.loadCloudSaveData();
            }
            if (!window.FirebasePvP || !window.FirebasePvP.ready) {
                window.onPvPAuthStateReady(false, 'Standalone File Mode');
            }
        });
    </script>
</body>
</html>
