                        : `<button onclick="buyGpLimitedPlayer('${item.id}')" class="w-full py-1.5 rounded-xl bg-gradient-to-r from-cyan-400 to-blue-500 hover:opacity-90 text-black text-[11px] font-black active:scale-95 transition-all">${item.price.toLocaleString()} GP</button>`
                    }
