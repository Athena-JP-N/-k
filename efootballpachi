        async function joinOnlineRoomById(roomId) {
            const pvp = window.FirebasePvP;
            if (!pvp || !pvp.ready || !pvp.db) {
                showOnlineBanner('オンラインサーバーに接続されていません。', true);
                return;
            }

            const { doc, getDoc, updateDoc, onSnapshot } = pvp.fns;
            const roomRef = doc(pvp.db, 'artifacts', pvp.appId, 'public', 'data', 'pvp_rooms', roomId);

            try {
                const snap = await getDoc(roomRef);
                if (!snap.exists()) {
                    showOnlineBanner(`ルーム「${roomId}」が見つかりません。`, true);
                    return;
                }
                const data = snap.data();
                if (data.status !== 'waiting') {
                    showOnlineBanner('このルームはすでに対戦中か終了しています。', true);
                    return;
                }

                await updateDoc(roomRef, {
                    status: 'playing',
                    guestUid: pvp.user.uid
                });

                currentOnlineRoomId = roomId;
                onlineRole = 'guest';

                if (roomUnsubscribe) roomUnsubscribe();
                roomUnsubscribe = onSnapshot(roomRef, (roomSnap) => {
                    if (!roomSnap.exists()) return;
                    const state = roomSnap.data();
                    if (isMatchRunning && onlineRole === 'guest') {
                        applyHostStateOnGuest(state);
                    }
                });

                startOnlineMatchClient('guest', roomId);
            } catch (err) {
                showOnlineBanner('ルーム参加エラー: ' + (err.message || ''), true);
            }
        }

