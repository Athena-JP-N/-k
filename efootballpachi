        function buyGpLimitedPlayer(playerId) {
            const item = gpShopPlayers.find(p => p.id === playerId);
            const msgEl = document.getElementById('gpShopMessageText');
            if (!item) return;
            const dispName = getDisplayPlayerName(item.name);

            const alreadyOwned = [...myTeamSquad, ...reservePlayers].some(p => p.name === item.name);
            if (alreadyOwned) {
                if (msgEl) {
                    msgEl.innerText = currentLang === 'en' ? `${dispName} is already in your squad.` : `${dispName} はすでに獲得済みです`;
                    msgEl.className = 'text-center text-xs font-bold text-emerald-300';
                }
                return;
            }

            if (userGP < item.price) {
                if (msgEl) {
                    msgEl.innerText = currentLang === 'en'
                        ? `Insufficient GP (Required: ${item.price.toLocaleString()} GP)`
                        : `GPが不足しています（必要: ${item.price.toLocaleString()} GP）`;
                    msgEl.className = 'text-center text-xs font-black text-red-400';
                }
                return;
            }

            userGP -= item.price;
            reservePlayers.unshift({
                name: item.name,
                pos: item.pos,
                compat: [...item.compat],
                ovr: item.ovr,
                spd: item.spd,
                drb: item.drb,
                rarity: item.rarity
            });

            updateCurrencyDisplays();
            renderGpShopList();
            if (msgEl) {
                msgEl.innerText = currentLang === 'en'
                    ? `Signed GP Legend "${dispName}"! Added to Reserves.`
                    : `GP限定選手「${dispName}」を獲得しました！（マイチームの控えに追加）`;
                msgEl.className = 'text-center text-xs font-black text-ef-yellow';
            }
            if (window.saveCloudData) window.saveCloudData(true);
        }

